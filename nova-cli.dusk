/**
 * nova-cli
 * The project generator for nova, in the shape of cobra-cli
 *
 *     nova-cli init [name] [--dir path] [--source src] [--ref ref] [--no-fetch]
 *     nova-cli add <name> [--parent root] [--dir path]
 *     nova-cli version
 *
 * Build it with dusk build nova-cli.dusk, which drops the binary at
 * target/dusk-out/nova-cli. This file lives inside the nova-cli project itself, so
 * @import nova.command resolves against the nova/ directory sitting beside it rather than
 * through a dawn alias, and the handlers under cli/ reach the same library through the
 * cli/nova symlink. A generated project gets nova as a dawn package and needs no symlink.
 *
 * This file holds the command tree and nothing else, every filesystem effect is in
 * cli/scaffold.dusk and every generated byte is in cli/templates.dusk, both std only and
 * independently type checkable.
 **/

@paradigm procedural

@import nova.command
@import nova.context
@import nova.flagset
@import nova.exec

@import cli.init_cmd
@import cli.add_cmd

/**
 * novacliVersion
 * The generator's own version, reported by nova-cli --version and nova-cli version
 * @return the version string
 **/
func novacliVersion() -> string {
    // The one place the version number is written
    return "0.2.0"
}

/**
 * novacliRunVersion
 * Prints the generator version, the handler behind nova-cli version
 * @param ctx {*Context} - the running context, unused here
 * @return 0
 **/
func novacliRunVersion(ctx: *Context) -> int32 {
    // Print the version on stdout
    println("nova-cli version {}", novacliVersion())

    // Report success
    return int32(0)
}

/**
 * novacliRoot
 * Builds the whole nova-cli command tree
 * @return the root command
 **/
func novacliRoot() -> *Command {
    // The root command itself
    c: *Command = cmdNew("nova-cli", "Generate and extend nova applications")
    // The long description shown by --help
    c.setLong("nova-cli scaffolds a nova application and adds commands to it, the way cobra-cli does for Cobra.\nStart with `nova-cli init --dir myapp`, then `nova-cli add serve --dir myapp`.")
    // The version --version reports
    c.setVersion(novacliVersion())

    // The version subcommand
    v: *Command = cmdNew("version", "Print the nova-cli version")
    // Its handler
    v.setRun(novacliRunVersion)

    // Hang init, add, and version off the root
    c.addCommand(initCmd())
    c.addCommand(addCmd())
    c.addCommand(v)

    // Return the finished tree
    return c
}

func main(argc: int32, argv: string[]) -> int32 {
    // The command tree
    root: *Command = novacliRoot()

    // Parse argv against the tree and run whatever it selects
    return novaExecute(root, argv)
}
