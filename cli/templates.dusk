/**
 * cli/templates.dusk
 * The text of every file nova-cli writes
 *
 * Pure text generation, std only, so dusk check cli/templates.dusk type-checks this file on
 * its own without the nova library present. Every export carries the tpl prefix. The
 * templates deliberately avoid f-strings, since the generated dusk source is full of { and
 * }, which an f-string would read as interpolation holes, so every template is assembled
 * with a StringBuilder instead.
 *
 * Identifier safety comes from scaffoldIdent, so my-cmd becomes my_cmd and the generated
 * my_cmdCmd() is a legal dusk name while cmdNew("my-cmd", ...) keeps the real command name
 * the user typed. Names reach these templates only after scaffoldValidName has accepted
 * them, so no name can carry a quote, a backslash, or whitespace into a generated string
 * literal. The flags of a --flags subcommand arrive the same way, already parsed and checked
 * by cli/flagspec.dusk, so a default is spliced in as it stands too, and every local a
 * handler reads one into carries a Flag suffix so a flag named for a dusk keyword, such as
 * for or match, still names something the generated file can declare.
 **/

@paradigm procedural

@import std.string
@import std.vector

@import scaffold
@import flagspec

/**
 * tplHeader
 * The banner every generated file opens with
 * @return a fresh heap string ending in a newline
 **/
func tplHeader() -> string {
    // The one line that says where the file came from
    return "// Generated by nova-cli, edit freely\n\n"
}

/**
 * tplRootFile
 * Builds the root program file, <dir>/<name>.dusk, which only builds the tree and runs it
 * @param name {string} - the application name, used for the greeting and nothing else here
 * @return the complete file text as a fresh heap string
 **/
export func tplRootFile(name: string) -> string {
    // The builder every line is pushed onto
    b: *StringBuilder = alloc(sb_new())

    // The generated banner
    sb_push(b, tplHeader())

    // The paradigm and the imports, nova through the manifest alias and cmd.root locally
    sb_push(b, "@paradigm procedural\n\n")
    sb_push(b, "@import nova.command\n")
    sb_push(b, "@import nova.exec\n")
    sb_push(b, "@import cmd.root\n\n")

    // main, which builds the tree and hands it to novaExecute
    sb_push(b, "func main(argc: int32, argv: string[]) -> int32 {\n")
    sb_push(b, "    // The command tree\n")
    sb_push(b, "    root: *Command = rootCmd()\n\n")
    sb_push(b, "    // Parse argv against the tree and run whatever it selects\n")
    sb_push(b, "    return novaExecute(root, argv)\n")
    sb_push(b, "}\n")

    // Copy the builder out before freeing it
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)

    // The finished file text
    return out
}

/**
 * tplRootCmd
 * Builds <dir>/cmd/root.dusk, the root command constructor and its handler
 * @param name {string} - the application name, which becomes the command's own name
 * @param docs {bool} - true to hang nova's hidden docs command off the root
 * @return the complete file text as a fresh heap string
 **/
export func tplRootCmd(name: string, docs: bool) -> string {
    // The builder every line is pushed onto
    b: *StringBuilder = alloc(sb_new())

    // The generated banner
    sb_push(b, tplHeader())

    // The paradigm and the three nova imports the file needs
    sb_push(b, "@paradigm procedural\n\n")
    sb_push(b, "@import nova.command\n")
    sb_push(b, "@import nova.context\n")
    sb_push(b, "@import nova.flagset\n")

    // The docs command lives in its own module, imported only when it is wired in
    if docs {
        sb_push(b, "@import nova.doc\n")
    }
    sb_push(b, "\n")

    // The handler's doc block
    sb_push(b, "/**\n")
    sb_push(b, " * rootRun\n")
    sb_push(b, " * Runs when ")
    sb_push(b, name)
    sb_push(b, " is called with no subcommand\n")
    sb_push(b, " * @param ctx {*Context} - the running context\n")
    sb_push(b, " * @return 0\n")
    sb_push(b, " **/\n")

    // The handler, which reads the persistent flag and greets
    sb_push(b, "func rootRun(ctx: *Context) -> int32 {\n")
    sb_push(b, "    // The persistent flag, which every command in the tree can read\n")
    sb_push(b, "    verbose: bool = ctx.getBool(\"verbose\")\n\n")
    sb_push(b, "    // Say so when it is set\n")
    sb_push(b, "    if verbose {\n")
    sb_push(b, "        println(\"")
    sb_push(b, name)
    sb_push(b, ": verbose mode\")\n")
    sb_push(b, "    }\n\n")
    sb_push(b, "    // The greeting\n")
    sb_push(b, "    println(\"Hello from ")
    sb_push(b, name)
    sb_push(b, "\")\n\n")
    sb_push(b, "    // Report success\n")
    sb_push(b, "    return int32(0)\n")
    sb_push(b, "}\n\n")

    // The constructor's doc block
    sb_push(b, "/**\n")
    sb_push(b, " * rootCmd\n")
    sb_push(b, " * Builds the root command of ")
    sb_push(b, name)
    sb_push(b, "\n")
    sb_push(b, " * @return the root command\n")
    sb_push(b, " **/\n")

    // The constructor, whose signature line and return c are the wiring anchors
    sb_push(b, "export func rootCmd() -> *Command {\n")
    sb_push(b, "    // The command itself\n")
    sb_push(b, "    c: *Command = cmdNew(\"")
    sb_push(b, name)
    sb_push(b, "\", \"A brief description of your application\")\n\n")
    sb_push(b, "    // The long description shown by --help\n")
    sb_push(b, "    c.setLong(\"A longer description of ")
    sb_push(b, name)
    sb_push(b, ", shown by --help.\")\n\n")
    sb_push(b, "    // The version --version reports\n")
    sb_push(b, "    c.setVersion(\"0.1.0\")\n\n")
    sb_push(b, "    // The handler\n")
    sb_push(b, "    c.setRun(rootRun)\n\n")
    sb_push(b, "    // A flag every command in the tree inherits\n")
    sb_push(b, "    c.persistentFlags().addBool(\"verbose\", \"v\", false, \"verbose output\")\n\n")

    // The hidden docs command, spliced in above the return c that anchors every later add
    if docs {
        sb_push(b, "    // The hidden docs command, which writes a markdown page per command\n")
        sb_push(b, "    c.addCommand(docCommandNew())\n\n")
    }
    sb_push(b, "    return c\n")
    sb_push(b, "}\n")

    // Copy the builder out before freeing it
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)

    // The finished file text
    return out
}

/**
 * tplKindGetter
 * The Context getter one flag kind is read with
 * @param k {SpecKind} - the kind
 * @return the method name, a static literal
 **/
func tplKindGetter(k: SpecKind) -> string {
    // One getter per kind, a choice reading back as the string it is
    match k {
        SBool => return "getBool",
        SStr => return "getStr",
        SInt => return "getInt",
        SFloat => return "getFloat",
        SStrs => return "getStrs",
        SCount => return "getCount",
        SChoice => return "getStr",
    }
    return "getStr"
}

/**
 * tplKindType
 * The dusk type the local holding one flag kind is annotated with
 * @param k {SpecKind} - the kind
 * @return the type text, a static literal
 **/
func tplKindType(k: SpecKind) -> string {
    // One type per kind, a count being the int64 it counts into
    match k {
        SBool => return "bool",
        SStr => return "string",
        SInt => return "int64",
        SFloat => return "float64",
        SStrs => return "*Vector<string>",
        SCount => return "int64",
        SChoice => return "string",
    }
    return "string"
}

/**
 * tplHasStrs
 * Whether any flag in a spec is a string slice, which is what pulls std into the generated file
 * @param specs {*Vector<*FlagSpec>} - the parsed flags
 * @return true when one of them is a strs flag
 **/
func tplHasStrs(specs: *Vector<*FlagSpec>) -> bool {
    // Cursor over the flags
    mut i: int64 = 0

    // Loop looking for the one kind whose local needs a type and a join
    while i < vec_len(specs) {
        f: *FlagSpec = vec_get(specs, i)
        if specKindIsStrs(f) {
            return true
        }
        i = i + 1
    }

    // No strs flag, so the file needs nothing from std
    return false
}

/**
 * tplPushFlagDecl
 * Appends the one localFlags().addX line a flag declares itself with
 * @param b {*StringBuilder} - the builder the file is assembled on
 * @param f {*FlagSpec} - the parsed flag
 * @return nothing
 **/
func tplPushFlagDecl(b: *StringBuilder, f: *FlagSpec) -> void {
    // The name as typed and the shorthand, which may be empty
    name: string = (*f).name
    short: string = (*f).short

    // The call, whose method is the kind's own
    sb_push(b, "    c.localFlags().")
    match (*f).kind {
        SBool => sb_push(b, "addBool("),
        SStr => sb_push(b, "addStr("),
        SInt => sb_push(b, "addInt("),
        SFloat => sb_push(b, "addFloat("),
        SStrs => sb_push(b, "addStrs("),
        SCount => sb_push(b, "addCount("),
        SChoice => sb_push(b, "addChoice("),
    }

    // The two names every kind takes first
    sb_push(b, "\"")
    sb_push(b, name)
    sb_push(b, "\", \"")
    sb_push(b, short)
    sb_push(b, "\", ")

    // The default, quoted for the kinds whose default is text and left bare for the rest
    match (*f).kind {
        SBool => {
            sb_push(b, (*f).def)
            sb_push(b, ", ")
        }
        SStr => {
            sb_push(b, "\"")
            sb_push(b, (*f).def)
            sb_push(b, "\", ")
        }
        SInt => {
            sb_push(b, (*f).def)
            sb_push(b, ", ")
        }
        SFloat => {
            sb_push(b, (*f).def)
            sb_push(b, ", ")
        }
        SStrs => {
            sb_push(b, "\"")
            sb_push(b, (*f).def)
            sb_push(b, "\", ")
        }
        SCount => {
            sb_push(b, "")
        }
        SChoice => {
            sb_push(b, "\"")
            sb_push(b, (*f).def)
            sb_push(b, "\", \"")
            sb_push(b, (*f).choices)
            sb_push(b, "\", ")
        }
    }

    // The help text, which is the last argument of every one of them
    sb_push(b, "\"the ")
    sb_push(b, name)
    sb_push(b, " flag\")\n")
}

/**
 * tplPushFlagRead
 * Appends the two blocks that read one flag into a local and print what it holds
 * @param b {*StringBuilder} - the builder the file is assembled on
 * @param f {*FlagSpec} - the parsed flag
 * @return nothing
 **/
func tplPushFlagRead(b: *StringBuilder, f: *FlagSpec) -> void {
    // The name as typed and the identifier it sanitizes to
    name: string = (*f).name
    id: string = scaffoldIdent(name)

    // The local the flag is read into, suffixed so a flag named for a dusk keyword, such as
    // for or match, still declares a name the generated file compiles with
    local: string = id + "Flag"
    free(id)

    // The local, annotated with the type its getter hands back
    sb_push(b, "    // The ")
    sb_push(b, name)
    sb_push(b, " flag\n")
    sb_push(b, "    ")
    sb_push(b, local)
    sb_push(b, ": ")
    sb_push(b, tplKindType((*f).kind))
    sb_push(b, " = ctx.")
    sb_push(b, tplKindGetter((*f).kind))
    sb_push(b, "(\"")
    sb_push(b, name)
    sb_push(b, "\")\n\n")

    // A string slice prints as the comma separated list it was declared with
    if specKindIsStrs(f) {
        sb_push(b, "    // Print its items joined the way they were declared\n")
        sb_push(b, "    ")
        sb_push(b, local)
        sb_push(b, "Joined: string = str_join(")
        sb_push(b, local)
        sb_push(b, ", \",\")\n")
        sb_push(b, "    println(\"")
        sb_push(b, name)
        sb_push(b, "={}\", ")
        sb_push(b, local)
        sb_push(b, "Joined)\n")
        sb_push(b, "    free(")
        sb_push(b, local)
        sb_push(b, "Joined)\n\n")
    } else {
        sb_push(b, "    // Print what it holds\n")
        sb_push(b, "    println(\"")
        sb_push(b, name)
        sb_push(b, "={}\", ")
        sb_push(b, local)
        sb_push(b, ")\n\n")
    }
    free(local)
}

/**
 * tplSubCmd
 * Builds <dir>/cmd/<id>_cmd.dusk, one subcommand with its handler and its flags
 * @param name {string} - the subcommand name as typed, which may contain dashes
 * @param parent {string} - the parent command's name, mentioned in the long description
 * @param specs {*Vector<*FlagSpec>} - the parsed --flags, empty for the plain template
 * @return the complete file text as a fresh heap string
 **/
export func tplSubCmd(name: string, parent: string, specs: *Vector<*FlagSpec>) -> string {
    // The sanitized identifier the constructor and the handler are named after
    id: string = scaffoldIdent(name)
    // The upper case name the loud branch prints
    shout: string = to_upper(name)
    // How many flags the spec declared, none meaning the plain template
    nflags: int64 = vec_len(specs)

    // The builder every line is pushed onto
    b: *StringBuilder = alloc(sb_new())

    // The generated banner
    sb_push(b, tplHeader())

    // The paradigm and the three nova imports the file needs
    sb_push(b, "@paradigm procedural\n\n")
    sb_push(b, "@import nova.command\n")
    sb_push(b, "@import nova.context\n")
    sb_push(b, "@import nova.flagset\n")

    // A strs flag reads back a vector and prints it joined, which is all std buys the file
    if tplHasStrs(specs) {
        sb_push(b, "\n@import std.string\n")
        sb_push(b, "@import std.vector\n")
    }
    sb_push(b, "\n")

    // The handler's doc block
    sb_push(b, "/**\n")
    sb_push(b, " * ")
    sb_push(b, id)
    sb_push(b, "Run\n")
    sb_push(b, " * Runs when ")
    sb_push(b, name)
    sb_push(b, " is called\n")
    sb_push(b, " * @param ctx {*Context} - the running context\n")
    sb_push(b, " * @return 0\n")
    sb_push(b, " **/\n")

    // The handler, <id>Run
    sb_push(b, "func ")
    sb_push(b, id)
    sb_push(b, "Run(ctx: *Context) -> int32 {\n")

    // With no flags declared it reads the one bool the plain template gives it
    if nflags == 0 {
        sb_push(b, "    // The local flag, which this command alone reads\n")
        sb_push(b, "    loud: bool = ctx.getBool(\"loud\")\n\n")
        sb_push(b, "    // Shout it when the flag is set, say it plainly otherwise\n")
        sb_push(b, "    if loud {\n")
        sb_push(b, "        println(\"")
        sb_push(b, shout)
        sb_push(b, " CALLED\")\n")
        sb_push(b, "    } else {\n")
        sb_push(b, "        println(\"")
        sb_push(b, name)
        sb_push(b, " called\")\n")
        sb_push(b, "    }\n\n")
    } else {
        // With a spec it says it ran and then prints one line per declared flag
        sb_push(b, "    // Say the command ran, ahead of everything its flags hold\n")
        sb_push(b, "    println(\"")
        sb_push(b, name)
        sb_push(b, " called\")\n\n")

        // Cursor over the flags
        mut i: int64 = 0

        // Loop reading each flag into a local and printing it
        while i < nflags {
            tplPushFlagRead(b, vec_get(specs, i))
            i = i + 1
        }
    }
    sb_push(b, "    // Report success\n")
    sb_push(b, "    return int32(0)\n")
    sb_push(b, "}\n\n")

    // The constructor's doc block
    sb_push(b, "/**\n")
    sb_push(b, " * ")
    sb_push(b, id)
    sb_push(b, "Cmd\n")
    sb_push(b, " * Builds the ")
    sb_push(b, name)
    sb_push(b, " command\n")
    sb_push(b, " * @return a fresh command, owned by the tree it is added to\n")
    sb_push(b, " **/\n")

    // The constructor, <id>Cmd, which is the name scaffoldAddWiring splices into the parent
    sb_push(b, "export func ")
    sb_push(b, id)
    sb_push(b, "Cmd() -> *Command {\n")
    sb_push(b, "    // The command itself\n")
    sb_push(b, "    c: *Command = cmdNew(\"")
    sb_push(b, name)
    sb_push(b, "\", \"A brief description of the ")
    sb_push(b, name)
    sb_push(b, " command\")\n\n")
    sb_push(b, "    // The long description shown by --help\n")
    sb_push(b, "    c.setLong(\"")
    sb_push(b, name)
    sb_push(b, " is a subcommand of ")
    sb_push(b, parent)
    sb_push(b, ".\")\n\n")
    sb_push(b, "    // The handler\n")
    sb_push(b, "    c.setRun(")
    sb_push(b, id)
    sb_push(b, "Run)\n\n")

    // The flags, the one the plain template gives or the ones the spec declared
    if nflags == 0 {
        sb_push(b, "    // A flag this command alone reads\n")
        sb_push(b, "    c.localFlags().addBool(\"loud\", \"l\", false, \"shout the output\")\n\n")
    } else {
        sb_push(b, "    // The flags --flags declared, which this command alone reads\n")

        // Cursor over the flags
        mut j: int64 = 0

        // Loop declaring each one in the order it was written
        while j < nflags {
            tplPushFlagDecl(b, vec_get(specs, j))
            j = j + 1
        }
        sb_push(b, "\n")
    }
    sb_push(b, "    return c\n")
    sb_push(b, "}\n")

    // Copy the builder out before freeing it
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(id)
    free(shout)

    // The finished file text
    return out
}

/**
 * tplGitignore
 * The .gitignore a generated project starts with, target/ and dawn_modules/
 * @return the complete file text as a fresh heap string
 **/
export func tplGitignore() -> string {
    // Build output and fetched dependencies, neither belongs in a repository
    return "target/\ndawn_modules/\n"
}

/**
 * tplPackageDawn
 * Builds <dir>/package.dawn, the dawn manifest that makes the directory a project
 * @param name {string} - the application name, both the package name and the root stem
 * @param source {string} - the nova repository, host/owner/repo or a full URL
 * @param ref {string} - the git tag, branch, or commit to pin nova at
 * @param vendored {bool} - true to leave the @require line out
 * @return the complete file text as a fresh heap string
 **/
export func tplPackageDawn(name: string, source: string, ref: string, vendored: bool) -> string {
    // The builder every line is pushed onto
    b: *StringBuilder = alloc(sb_new())

    // The generated banner, written straight since a manifest is not dusk source
    sb_push(b, "// Generated by nova-cli, edit freely\n\n")

    // The package name
    sb_push(b, "@package ")
    sb_push(b, name)

    // The version, the compiler floor the manifest system landed in, and the root file
    sb_push(b, "\n@version 0.1.0\n@dusk 1.14\n@root ")
    sb_push(b, name)
    sb_push(b, ".dusk\n")

    // The requirement dawn get fetches, left out for a project carrying its own copy
    if !vendored {
        sb_push(b, "@require nova ")
        sb_push(b, source)
        sb_push(b, " ")
        sb_push(b, ref)
        sb_push(b, "\n")
    }

    // Copy the builder out before freeing it
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)

    // The finished file text
    return out
}
