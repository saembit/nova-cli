# fish completion for todo
#
# Generated by nova. Every candidate comes from the program itself, so the
# script keeps working when the commands or the flags change.
#
#   todo completion fish | source

function __todo_perform_completion
    # The line so far and the word being completed
    set -l args (commandline -opc)
    set -l tok (commandline -ct)

    # Ask the program itself for the candidates
    set -l out ($args[1] __complete $args[2..-1] "$tok" 2>/dev/null)
    set -l n (count $out)
    if test $n -eq 0
        return
    end

    # The last line is the directive and the rest are candidates
    set -l directive (string replace ':' '' -- $out[$n])
    set -e out[$n]
    for line in $out
        printf '%s\n' $line
    end

    # File names unless the program set the no file completion bit
    if not contains -- $directive 4 5 6 7
        __fish_complete_path "$tok"
    end
end

complete -c todo -f -a '(__todo_perform_completion)'
