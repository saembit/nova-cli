# bash completion for todo
#
# Generated by nova. Every candidate comes from the program itself, so the
# script keeps working when the commands or the flags change.
#
#   source <(todo completion bash)

_todo_completions()
{
    local cur out lastline directive merged words i w last c pfx tail IFS
    COMPREPLY=()

    # Glue back what COMP_WORDBREAKS split on "=" and ":"
    merged=()
    i=0
    while [ "$i" -le "$COMP_CWORD" ]; do
        w="${COMP_WORDS[$i]}"
        last=$(( ${#merged[@]} - 1 ))
        if [ "$last" -ge 0 ] && { [ "$w" = "=" ] || [ "$w" = ":" ]; }; then
            merged[$last]="${merged[$last]}$w"
        elif [ "$last" -ge 0 ] && { [ "${merged[$last]: -1}" = "=" ] || [ "${merged[$last]: -1}" = ":" ]; }; then
            merged[$last]="${merged[$last]}$w"
        else
            merged+=("$w")
        fi
        i=$(( i + 1 ))
    done

    # The word being completed and the line before it
    last=$(( ${#merged[@]} - 1 ))
    cur="${merged[$last]}"
    words=()
    if [ "$last" -gt 1 ]; then
        words=("${merged[@]:1:last-1}")
    fi

    # Ask the program itself for the candidates
    out="$("${merged[0]}" __completeNoDesc ${words[@]+"${words[@]}"} "$cur" 2>/dev/null)"

    # The last line is the directive and the rest are candidates
    lastline="${out##*$'\n'}"
    if [ "$lastline" = "$out" ]; then
        out=""
    else
        out="${out%$'\n'*}"
    fi
    case "$lastline" in
        :[0-9]*) directive="${lastline#:}" ;;
        *) directive=0 ;;
    esac

    # The error bit means the program had nothing to say
    if [ $(( directive & 1 )) -ne 0 ]; then
        return 1
    fi

    # File names and the trailing space, both only where compopt exists
    if type compopt > /dev/null 2>&1; then
        if [ $(( directive & 4 )) -ne 0 ]; then
            compopt +o default
        else
            compopt -o default
        fi
        if [ $(( directive & 2 )) -ne 0 ]; then
            compopt -o nospace
        fi
    fi

    # Keep the candidates the word being completed starts
    IFS=$'\n'
    COMPREPLY=( $(compgen -W "$out" -- "$cur") )

    # Cut what COMP_WORDBREAKS took off the front, readline replaces its own word alone
    for c in '=' ':'; do
        if [[ "$cur" != *"$c"* || "$COMP_WORDBREAKS" != *"$c"* ]]; then
            continue
        fi
        tail=${cur##*$c}
        pfx=${cur%"$tail"}
        i=0
        while [ "$i" -lt "${#COMPREPLY[@]}" ]; do
            COMPREPLY[$i]=${COMPREPLY[$i]#"$pfx"}
            i=$(( i + 1 ))
        done
    done
}

complete -o default -F _todo_completions todo
