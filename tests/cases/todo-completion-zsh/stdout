#compdef todo
# zsh completion for todo
#
# Generated by nova. Every candidate comes from the program itself, so the
# script keeps working when the commands or the flags change.
#
#   source <(todo completion zsh)

_todo()
{
    local out line comp directive
    local -a candidates args opts

    # The line so far with the program name dropped
    args=("${(@)words[2,CURRENT-1]}")

    # Ask the program itself for the candidates
    out=$(${words[1]} __complete "${args[@]}" "${words[CURRENT]}" 2>/dev/null)

    # The last line is the directive and the rest are candidates
    directive=0
    for line in ${(f)out}; do
        if [[ ${line} == :[0-9]* ]]; then
            directive=${line#:}
        else
            comp=${line//:/\\:}
            comp=${comp/$'\t'/:}
            candidates+=(${comp})
        fi
    done

    # The error bit means the program had nothing to say
    if (( (directive & 1) != 0 )); then
        return 1
    fi

    # No space after a candidate when the no space bit is set
    if (( (directive & 2) != 0 )); then
        opts+=(-S '')
    fi

    # The candidates, or file names when the program left that to the shell
    if (( ${#candidates[@]} > 0 )); then
        _describe -t todo 'todo' candidates "${opts[@]}"
    elif (( (directive & 4) == 0 )); then
        _files
    fi
}

compdef _todo todo
