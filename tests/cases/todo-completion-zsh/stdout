#compdef todo
#
# zsh completion for todo, generated by nova. It reuses the bash
# completion function: bashcompinit provides compgen and complete under
# zsh, and complete registers the function with compdef for us.
#
#   source <(todo completion zsh)

autoload -U +X bashcompinit && bashcompinit

_todo_completions()
{
    local cur cmd word opts i
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    cmd=""
    i=1
    while [ "$i" -lt "$COMP_CWORD" ]; do
        word="${COMP_WORDS[$i]}"
        i=$((i + 1))
        case "$word" in
            -*) continue ;;
        esac
        case "$cmd|$word" in
            "|add") cmd="add" ;;
            "|completion") cmd="completion" ;;
            "|config") cmd="config" ;;
            "config|get") cmd="config get" ;;
            "config|set") cmd="config set" ;;
            "|done") cmd="done" ;;
            "|help") cmd="help" ;;
            "|list") cmd="list" ;;
            "|ls") cmd="list" ;;
            *) continue ;;
        esac
    done
    opts=""
    case "$cmd" in
        "") opts="add completion config done help list -h --help --verbose --version" ;;
        "add") opts="-h --help --verbose" ;;
        "completion") opts="bash zsh -h --help --verbose" ;;
        "config") opts="get set -h --help --verbose" ;;
        "config get") opts="-h --help --verbose" ;;
        "config set") opts="-h --help --verbose" ;;
        "done") opts="-h --by --help --verbose" ;;
        "help") opts="-h --help --verbose" ;;
        "list") opts="-h --all --help --verbose" ;;
    esac
    COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
    return 0
}

complete -o default -F _todo_completions todo
