/**
 * nova/parse.dusk
 * The two pass argv scanner novaExecute drives, pass 1 finds the command, pass 2 parses the flags
 **/
@paradigm oop
@paradigm procedural

@import std.string
@import std.vector
@import flagset
@import text
@import sink
@import command
@import context

/**
 * ParseState
 * The scanner state for one novaExecute call, parseFind fills chain and toks, parseAll fills pos and helpRequested
 **/
export struct ParseState {
    chain: *Vector<*Command>,
    pos: *Vector<string>,
    argv: string[],
    words: *Vector<string>,
    useWords: bool,
    toks: *Vector<string>,
    i: int64,
    helpRequested: bool,
    stopFlags: bool,
    skipHidden: bool,
}

// Builds a scanner over either an argv or a word vector, the shared body of the two constructors
func parseStateMake(rootc: *Command, argv: string[], words: *Vector<string>, useWords: bool) -> *ParseState {
    // The chain of commands matched so far, starting at the root
    chain: *Vector<*Command> = alloc(vec_new())
    vec_push(chain, rootc)

    // The positionals and the tokens pass 2 will parse
    pos: *Vector<string> = alloc(vec_new())
    toks: *Vector<string> = alloc(vec_new())

    // Return the state on the heap
    return alloc(ParseState {
        chain: chain, pos: pos, argv: argv, words: words, useWords: useWords,
        toks: toks, i: 0,
        helpRequested: false, stopFlags: false, skipHidden: false,
    })
}

/**
 * parseStateNew
 * Builds a fresh scanner with the root as the only chain entry
 * @param rootc {*Command} - the root command
 * @param argv {string[]} - the raw argv, argv[0] is the program name
 * @return the new state on the heap
 **/
export func parseStateNew(rootc: *Command, argv: string[]) -> *ParseState {
    // The empty word vector the argv form never reads
    words: *Vector<string> = alloc(vec_new())

    // Return a state that walks argv
    return parseStateMake(rootc, argv, words, false)
}

/**
 * parseStateNewFromVector
 * Builds a fresh scanner over a vector of words rather than an argv, which is what the completion handler has to work with
 * @param rootc {*Command} - the root command
 * @param argv {string[]} - the raw argv, kept only so a Context built from this state carries it, never scanned
 * @param words {*Vector<string>} - the words after the program name, the state takes the vector over and parseStateFree frees it while the strings inside stay borrowed
 * @return the new state on the heap
 **/
export func parseStateNewFromVector(rootc: *Command, argv: string[], words: *Vector<string>) -> *ParseState {
    // Return a state that walks the words
    return parseStateMake(rootc, argv, words, true)
}

// The number of words after the program name, from the argv or from the word vector
func parseWordCount(st: *ParseState) -> int64 {
    // The word vector form counts every word in it
    if (*st).useWords {
        return vec_len((*st).words)
    }

    // The argv form counts everything after the program name
    argv: string[] = (*st).argv
    return argv.len - 1
}

// The word at index i counting from the first one after the program name
func parseWordAt(st: *ParseState, i: int64) -> string {
    // The word vector form reads it straight out
    if (*st).useWords {
        return vec_get((*st).words, i)
    }

    // The argv form skips the program name
    argv: string[] = (*st).argv
    return argv[i + 1]
}

/**
 * parseStateFree
 * Frees the chain, pos, toks and words vectors of a scanner, the commands and strings inside them are borrowed and stay, the state struct itself is left for its owner to free, nothing handed out from the state may be used after this returns
 * @param st {*ParseState} - the scanner whose vectors to free
 * @return nothing
 **/
export func parseStateFree(st: *ParseState) -> void {
    // Free the chain vector
    vec_free((*st).chain)
    free((*st).chain)

    // Free the positional vector
    vec_free((*st).pos)
    free((*st).pos)

    // Free the token vector
    vec_free((*st).toks)
    free((*st).toks)

    // Free the word vector, empty on the argv form and owned by the state on the other one
    vec_free((*st).words)
    free((*st).words)
}

/**
 * parseCur
 * Gets the deepest command found so far, the last chain entry
 * @param st {*ParseState} - the scanner
 * @return the command at the end of the chain
 **/
export func parseCur(st: *ParseState) -> *Command {
    // The chain in the state
    chain: *Vector<*Command> = (*st).chain

    // Return the last entry
    return vec_get(chain, vec_len(chain) - 1)
}

/**
 * parseFindLongTakesValue
 * Checks if a long token in pass 1 takes the next token as its value
 * @param chain {*Vector<*Command>} - the commands matched so far
 * @param tok {string} - the long flag token
 * @return true when the flag is unknown or is of a kind that wants a value
 **/
func parseFindLongTakesValue(chain: *Vector<*Command>, tok: string) -> bool {
    // A token with "=" already carries its value
    if str_contains(tok, "=") {
        return false
    }

    // The flag name after the dashes
    name: string = substring(tok, 2, str_len(tok))

    // Look the name up on the chain
    fset, idx, found := ctxLookupChain(chain, name)

    // An unknown flag takes a value unless it is help
    if !found {
        // Whether the token was the undeclared help flag
        isHelp: bool = name == "help"

        // Free the name and answer
        free(name)
        return !isHelp
    }

    // The name is done with
    free(name)

    // The flag the name resolved to
    f: *Flag = fset.get(idx)

    // Only a kind that wants a value takes one, a bool and a count swallow nothing
    return flagTakesValue(f)
}

/**
 * parseFindShortTakesValue
 * Checks if a short token in pass 1 takes the next token as its value
 * @param chain {*Vector<*Command>} - the commands matched so far
 * @param tok {string} - the short flag token
 * @return true when the token is two bytes and its shorthand is unknown or is of a kind that wants a value
 **/
func parseFindShortTakesValue(chain: *Vector<*Command>, tok: string) -> bool {
    // Only a two byte token can take the next token
    if str_len(tok) != 2 {
        return false
    }

    // The shorthand letter
    ch: string = textCharAt(tok, 1)

    // Look the shorthand up on the chain
    fset, idx, found := ctxLookupShortChain(chain, ch)

    // An unknown shorthand takes a value unless it is h
    if !found {
        // Whether the token was the undeclared help shorthand
        isHelp: bool = ch == "h"

        // Free the letter and answer
        free(ch)
        return !isHelp
    }

    // The letter is done with
    free(ch)

    // The flag the shorthand resolved to
    f: *Flag = fset.get(idx)

    // Only a kind that wants a value takes one, a bool and a count swallow nothing
    return flagTakesValue(f)
}

/**
 * parseFind
 * Pass 1, walks argv[1..] from the root and descends into each child a word names, every other token goes to the token list
 * @param st {*ParseState} - the scanner
 * @return ...
 **/
export func parseFind(st: *ParseState) -> void {
    // The chain, the token list and how many words there are to walk
    chain: *Vector<*Command> = (*st).chain
    toks: *Vector<string> = (*st).toks
    n: int64 = parseWordCount(st)

    // Whether we are still matching command words
    mut descending: bool = true

    // Loop over the words after the program name
    mut i: int64 = 0
    while i < n {
        // The current token
        tok: string = parseWordAt(st, i)
        i = i + 1

        // Once descending stops every token is kept for pass 2
        if !descending {
            vec_push(toks, tok)
            continue
        }

        // The deepest command so far
        curc: *Command = parseCur(st)

        // A command without flag parsing or a "--" ends the walk
        if (*curc).disableFlagParsing || tok == "--" {
            descending = false
            vec_push(toks, tok)
            continue
        }

        // A long flag is kept, along with its value token when it takes one
        if textIsLongFlag(tok) {
            vec_push(toks, tok)
            if parseFindLongTakesValue(chain, tok) && i < n {
                vec_push(toks, parseWordAt(st, i))
                i = i + 1
            }
            continue
        }

        // A short flag is kept, along with its value token when it takes one
        if textIsShortFlag(tok) {
            vec_push(toks, tok)
            if parseFindShortTakesValue(chain, tok) && i < n {
                vec_push(toks, parseWordAt(st, i))
                i = i + 1
            }
            continue
        }

        // Descend into the child the word names, unless it is a hidden builtin a completion run must not walk into
        j: int64 = curc.findChild(tok)
        if j >= 0 {
            k: *Command = curc.child(j)
            if !((*st).skipHidden && (*k).hidden && (*k).isBuiltin) {
                vec_push(chain, k)
                continue
            }
        }

        // The first word naming no child stops the walk
        descending = false
        vec_push(toks, tok)
    }
}

// Writes the deprecation warning to the err sink of the chain when the flag carries a message
func parseWarnDeprecated(st: *ParseState, f: *Flag) -> void {
    // Nothing to warn about
    if (*f).deprecated == "" {
        return
    }

    // The warning line and the sink the run writes it to
    line: string = textCat5("Flag --", (*f).name, " has been deprecated, ", (*f).deprecated, "\n")
    chain: *Vector<*Command> = (*st).chain

    // Write the warning and free the line
    sinkWrite(sinkResolveErr(chain), line)
    free(line)
}

// Takes the next token as a flag value, false when the tokens are used up
func parseTakeNext(st: *ParseState) -> (string, bool) {
    // The token list and the cursor
    toks: *Vector<string> = (*st).toks
    i: int64 = (*st).i

    // No token left
    if i >= vec_len(toks) {
        return ("", false)
    }

    // Move the cursor and return the token
    (*st).i = i + 1
    return (vec_get(toks, i), true)
}

/**
 * parseHelpFlag
 * Records a --help request, bare means true, "=value" is parsed as a bool
 * @param st {*ParseState} - the scanner
 * @param val {string} - the value after "=" if any
 * @param hadEq {bool} - whether the token had an "="
 * @return a clean error or the invalid argument error
 **/
func parseHelpFlag(st: *ParseState, val: string, hadEq: bool) -> error {
    // A bare --help is a request
    if !hadEq {
        (*st).helpRequested = true
        return error {}
    }

    // Parse the value as a bool
    b, e := flagParseBool(val)
    if e.exists() {
        // The quoted value and the message built around it
        q: string = textQuote(val)
        msg: string = textCat3("invalid argument ", q, " for \"--help\" flag: expected a boolean")

        // Free the quoted copy
        free(q)
        return error { message: msg }
    }

    // Record the parsed value
    (*st).helpRequested = b
    return error {}
}

/**
 * parseLongFlag
 * Consumes one long flag token, "--name" or "--name=value", taking the next token as the value when needed
 * @param st {*ParseState} - the scanner
 * @param tok {string} - the token, starts with "--" and is longer than 2 bytes
 * @return a clean error, or the bad flag syntax, unknown flag, flag needs an argument or invalid argument error
 **/
export func parseLongFlag(st: *ParseState, tok: string) -> error {
    // A name starting with "-" or "=" is bad syntax
    if tok[2] == 45 || tok[2] == 61 {
        return error { message: "bad flag syntax: " + tok }
    }

    // Split the body into name and value
    body: string = substring(tok, 2, str_len(tok))
    name, val, hadEq := textSplitEq(body)

    // Consume the flag the name resolves to
    e: error = parseLongNamed(st, name, val, hadEq)

    // Free the three pieces the split minted, a flag that took a value kept a copy of its own
    free(val)
    free(name)
    free(body)
    return e
}

// Consumes one long flag once its token is split into a name, the value after the "=" and whether there was one at all
func parseLongNamed(st: *ParseState, name: string, val: string, hadEq: bool) -> error {
    // Look the name up on the chain
    chain: *Vector<*Command> = (*st).chain
    fset, idx, found := ctxLookupChain(chain, name)

    // An unknown name is the help request or an error
    if !found {
        if name == "help" {
            return parseHelpFlag(st, val, hadEq)
        }
        return error { message: "unknown flag: --" + name }
    }

    // The flag the name resolved to
    f: *Flag = fset.get(idx)

    // A bool flag is set on, or set from its "=value"
    if flagKindEq((*f).kind, FlagKind.KBool) {
        if hadEq {
            e: error = fset.setValue(idx, val)
            if e.exists() {
                return e
            }
        } else {
            fset.setBoolOn(idx)
        }
        parseWarnDeprecated(st, f)
        return error {}
    }

    // A count flag counts one more, or is set outright from its "=value"
    if flagKindEq((*f).kind, FlagKind.KCount) {
        if hadEq {
            e3: error = fset.setValue(idx, val)
            if e3.exists() {
                return e3
            }
        } else {
            fset.bump(idx)
        }
        parseWarnDeprecated(st, f)
        return error {}
    }

    // The raw value, taken from the next token when none was attached
    mut raw: string = val
    if !hadEq {
        nxt, ok := parseTakeNext(st)
        if !ok {
            return error { message: "flag needs an argument: --" + name }
        }
        raw = nxt
    }

    // Set the value on the flag
    e2: error = fset.setValue(idx, raw)
    if e2.exists() {
        return e2
    }

    // Warn when the flag is deprecated
    parseWarnDeprecated(st, f)
    return error {}
}

/**
 * parseShortCluster
 * Consumes one short flag token or cluster such as "-v", "-abc", "-vvv", "-p8080", "-p=8080", "-p 8080"
 * @param st {*ParseState} - the scanner
 * @param tok {string} - the token, starts with "-" followed by a non dash non digit
 * @return a clean error, or the unknown shorthand flag, flag needs an argument or invalid argument error
 **/
export func parseShortCluster(st: *ParseState, tok: string) -> error {
    // The token length and the chain
    n: int64 = str_len(tok)
    chain: *Vector<*Command> = (*st).chain

    // Loop over the letters after the dash
    mut k: int64 = 1
    while k < n {
        // The current shorthand letter
        ch: string = textCharAt(tok, k)

        // Look the shorthand up on the chain
        fset, idx, found := ctxLookupShortChain(chain, ch)

        // An unknown shorthand is the help request or an error
        if !found {
            if ch == "h" {
                free(ch)
                (*st).helpRequested = true
                k = k + 1
                continue
            }

            // The rest of the cluster the message points at
            rest: string = substring(tok, k, n)
            msg: string = textCat4("unknown shorthand flag: '", ch, "' in -", rest)

            // Free the two pieces the message copied
            free(rest)
            free(ch)
            return error { message: msg }
        }

        // The flag the shorthand resolved to
        f: *Flag = fset.get(idx)

        // A bool flag is set on and the cluster goes on
        if flagKindEq((*f).kind, FlagKind.KBool) {
            free(ch)
            fset.setBoolOn(idx)
            parseWarnDeprecated(st, f)
            k = k + 1
            continue
        }

        // A count flag counts one more per letter, and an "=value" sets it outright and ends the cluster
        if flagKindEq((*f).kind, FlagKind.KCount) {
            free(ch)
            if k + 1 < n && tok[k + 1] == 61 {
                // The digits after the "="
                digits: string = substring(tok, k + 2, n)
                e3: error = fset.setValue(idx, digits)

                // Free the copy the flag no longer needs
                free(digits)
                if e3.exists() {
                    return e3
                }
                parseWarnDeprecated(st, f)
                k = n
            } else {
                fset.bump(idx)
                parseWarnDeprecated(st, f)
                k = k + 1
            }
            continue
        }

        // The value is the rest of the cluster when there is one, after an optional "="
        if k + 1 < n {
            // Where the value starts, past the "=" when the cluster carries one
            cut: int64 = if tok[k + 1] == 61 { k + 2 } else { k + 1 }

            // The rest of the cluster as the value
            raw: string = substring(tok, cut, n)
            e: error = fset.setValue(idx, raw)

            // Free the copy the flag no longer needs
            free(raw)
            free(ch)
            if e.exists() {
                return e
            }

            // Warn when the flag is deprecated and end the cluster
            parseWarnDeprecated(st, f)
            k = n
            continue
        }

        // Otherwise the next token carries it
        nxt, ok := parseTakeNext(st)
        if !ok {
            // The rest of the cluster the message points at
            rest2: string = substring(tok, k, n)
            msg2: string = textCat4("flag needs an argument: '", ch, "' in -", rest2)

            // Free the two pieces the message copied
            free(rest2)
            free(ch)
            return error { message: msg2 }
        }

        // Set the value on the flag
        e2: error = fset.setValue(idx, nxt)
        free(ch)
        if e2.exists() {
            return e2
        }

        // Warn when the flag is deprecated and end the cluster
        parseWarnDeprecated(st, f)
        k = n
    }
    return error {}
}

/**
 * parseAll
 * Pass 2, parses every token parseFind left against the leaf's flags, the rest are positionals
 * @param st {*ParseState} - the scanner, after parseFind
 * @return a clean error or the first flag error met
 **/
export func parseAll(st: *ParseState) -> error {
    // The token list, positionals and the leaf command
    toks: *Vector<string> = (*st).toks
    pos: *Vector<string> = (*st).pos
    leaf: *Command = parseCur(st)

    // Loop over the tokens from the cursor
    while (*st).i < vec_len(toks) {
        // The current token
        tok: string = vec_get(toks, (*st).i)
        (*st).i = (*st).i + 1

        // Every token is a positional once flag parsing is off
        if (*leaf).disableFlagParsing || (*st).stopFlags {
            vec_push(pos, tok)
            continue
        }

        // A "--" ends flag parsing
        if tok == "--" {
            (*st).stopFlags = true
            continue
        }

        // Parse a long flag
        if textIsLongFlag(tok) {
            e: error = parseLongFlag(st, tok)
            if e.exists() {
                return e
            }
            continue
        }

        // Parse a short flag or cluster
        if textIsShortFlag(tok) {
            e2: error = parseShortCluster(st, tok)
            if e2.exists() {
                return e2
            }
            continue
        }

        // Anything else is a positional
        vec_push(pos, tok)
    }
    return error {}
}
