/**
 * nova/exec.dusk
 * novaExecuteE and novaExecute, the entry points an application's main calls with its root command and argv
 **/
@paradigm oop
@paradigm procedural

@import std.string
@import std.vector
@import flagset
@import flaggroup
@import args
@import text
@import sink
@import command
@import context
@import help
@import completion
@import parse

// Walks the whole tree, sets every path, resets every flag and adds the builtin commands and --version flag
func execFixup(rootc: *Command) -> void {
    // Add the builtin help command when it applies
    if !(*rootc).disableHelpCmd && rootc.numChildren() > 0 && rootc.findChild("help") < 0 {
        rootc.addCommand(helpCommandNew((*rootc).name))
    }

    // Add the builtin completion command when it applies
    if !(*rootc).disableCompletionCmd && rootc.numChildren() > 0 && rootc.findChild("completion") < 0 {
        rootc.addCommand(completionCommandNew((*rootc).name))
    }

    // Add the root's --version flag when a version is declared
    if (*rootc).version != "" {
        rf: *FlagSet = (*rootc).flags
        rp: *FlagSet = (*rootc).pflags
        if !rf.has("version") && !rp.has("version") {
            rf.addBool("version", "", false, helpVersionHelp(rootc))
        }
    }

    // The root path is its name
    (*rootc).path = (*rootc).name

    // The worklist of commands to visit
    work: *Vector<*Command> = alloc(vec_new())
    vec_push(work, rootc)

    // Loop over the worklist
    mut w: int64 = 0
    while w < vec_len(work) {
        // The current command
        c: *Command = vec_get(work, w)

        // Reset its local and persistent flags
        lf: *FlagSet = (*c).flags
        pf: *FlagSet = (*c).pflags
        lf.reset()
        pf.reset()

        // Set the path of each child and queue it
        kids: *Vector<*Command> = (*c).kids
        mut i: int64 = 0
        while i < vec_len(kids) {
            k: *Command = vec_get(kids, i)
            (*k).path = (*c).path + " " + (*k).name
            vec_push(work, k)
            i = i + 1
        }
        w = w + 1
    }
}

/**
 * execVersionRequested
 * Checks if the root's auto added --version flag was set
 * @param rootc {*Command} - the root command
 * @param chainLen {int64} - the length of the matched chain
 * @return true when the root alone was named and the flag is on
 **/
func execVersionRequested(rootc: *Command, chainLen: int64) -> bool {
    // Only the root with a declared version can be asked
    if chainLen != 1 || (*rootc).version == "" {
        return false
    }

    // Find the version flag on the root
    rf: *FlagSet = (*rootc).flags
    i: int64 = rf.find("version")
    if i < 0 {
        return false
    }

    // The flag must be the auto added bool
    f: *Flag = rf.get(i)
    if !flagKindEq((*f).kind, FlagKind.KBool) {
        return false
    }

    // Return its value
    return (*f).valB
}

// Pushes the names of the required but unset flags of fset onto out
func execCollectMissing(out: *Vector<string>, fset: *FlagSet) -> void {
    // Loop over the flags in the set
    mut i: int64 = 0
    while i < fset.len() {
        // Push the name when required and not changed
        f: *Flag = fset.get(i)
        if (*f).required && !(*f).changed {
            vec_push(out, (*f).name)
        }
        i = i + 1
    }
}

// Builds the "required flag(s) ... not set" error over the chain, clean when none are missing
func execCheckRequired(chain: *Vector<*Command>) -> error {
    // The names of the missing flags
    missing: *Vector<string> = alloc(vec_new())

    // The leaf's local flags
    n: int64 = vec_len(chain)
    leaf: *Command = vec_get(chain, n - 1)
    lf: *FlagSet = (*leaf).flags
    execCollectMissing(missing, lf)

    // The persistent flags of every chain entry
    mut i: int64 = 0
    while i < n {
        c: *Command = vec_get(chain, i)
        pf: *FlagSet = (*c).pflags
        execCollectMissing(missing, pf)
        i = i + 1
    }

    // Nothing missing
    if vec_len(missing) == 0 {
        return error {}
    }

    // Sort the names and build the message
    vec_sort(missing, str_cmp)
    joined: string = textJoinQuoted(missing, ", ")
    return error { message: "required flag(s) " + joined + " not set" }
}

// Checks the leaf's flag groups in declaration order, the first one the run breaks wins
func execCheckGroups(chain: *Vector<*Command>, leaf: *Command) -> error {
    // The groups the leaf declares
    groups: *Vector<*FlagGroup> = (*leaf).groups

    // Loop over the groups in declaration order
    mut i: int64 = 0
    while i < vec_len(groups) {
        // Check the current group against the run
        gerr: error = flagGroupCheck(chain, vec_get(groups, i))

        // Return the first group the run breaks
        if gerr.exists() {
            return gerr
        }
        i = i + 1
    }

    // Every group holds
    return error {}
}

// Finds the index of the nearest chain entry with a persistentPreRun of either form, or -1
func execNearestPpre(chain: *Vector<*Command>) -> int64 {
    // Walk the chain from the leaf up
    mut k: int64 = vec_len(chain) - 1
    while k >= 0 {
        c: *Command = vec_get(chain, k)
        if (*c).hasPpre || (*c).hasPpreE {
            return k
        }
        k = k - 1
    }
    return -1
}

// Finds the index of the nearest chain entry with a persistentPostRun of either form, or -1
func execNearestPpost(chain: *Vector<*Command>) -> int64 {
    // Walk the chain from the leaf up
    mut k: int64 = vec_len(chain) - 1
    while k >= 0 {
        c: *Command = vec_get(chain, k)
        if (*c).hasPpost || (*c).hasPpostE {
            return k
        }
        k = k - 1
    }
    return -1
}

// Runs one hook slot, the E form when that is the one set, and reports an error it hands back against the leaf
func execCallHook(ctx: *Context, hasE: bool, fe: (*Context) -> error, fi: (*Context) -> int32) -> (int32, error) {
    // The E form, whose error nova reports itself and turns into exit code 1
    if hasE {
        // Run it and look at what came back
        e: error = fe(ctx)

        // An error ends the chain here
        if e.exists() {
            chain: *Vector<*Command> = (*ctx).chain
            return (ctxReportError(chain, (*ctx).cmd, e.message), e)
        }

        // Nothing to report
        return (0, error {})
    }

    // The int32 form, whose nonzero return is the exit code and no error at all
    return (fi(ctx), error {})
}

// Runs the hooks for ctx in order, the first nonzero code or error wins
func execRunHooks(ctx: *Context) -> (int32, error) {
    // The chain and the command that runs
    chain: *Vector<*Command> = (*ctx).chain
    curc: *Command = (*ctx).cmd

    // Run the nearest persistentPreRun
    ppre: int64 = execNearestPpre(chain)
    if ppre >= 0 {
        pc: *Command = vec_get(chain, ppre)
        r1, e1 := execCallHook(ctx, (*pc).hasPpreE, (*pc).persistentPreRunE, (*pc).persistentPreRun)
        if r1 != 0 {
            return (r1, e1)
        }
        e1.ignore()
    }

    // Run the preRun
    if (*curc).hasPre || (*curc).hasPreE {
        r2, e2 := execCallHook(ctx, (*curc).hasPreE, (*curc).preRunE, (*curc).preRun)
        if r2 != 0 {
            return (r2, e2)
        }
        e2.ignore()
    }

    // Run the command itself
    r3, e3 := execCallHook(ctx, (*curc).hasRunE, (*curc).runE, (*curc).run)
    if r3 != 0 {
        return (r3, e3)
    }
    e3.ignore()

    // Run the postRun
    if (*curc).hasPost || (*curc).hasPostE {
        r4, e4 := execCallHook(ctx, (*curc).hasPostE, (*curc).postRunE, (*curc).postRun)
        if r4 != 0 {
            return (r4, e4)
        }
        e4.ignore()
    }

    // Run the nearest persistentPostRun
    ppost: int64 = execNearestPpost(chain)
    if ppost >= 0 {
        pc2: *Command = vec_get(chain, ppost)
        return execCallHook(ctx, (*pc2).hasPpostE, (*pc2).persistentPostRunE, (*pc2).persistentPostRun)
    }

    // Every hook is done and none of them complained
    return (0, error {})
}

// Reports the unknown command error for word against subject and hands it back
func execUnknownCommand(chain: *Vector<*Command>, subject: *Command, word: string) -> (int32, error) {
    // The message Cobra prints for a word that names no command
    msg: string = "unknown command \"" + word + "\" for \"" + (*subject).path + "\""

    // Report it against the command the word was typed under
    return (ctxReportError(chain, subject, msg), error { message: msg })
}

/**
 * execRunDispatch
 * Does what the parsed line asked for, help, the version line, an error report or the hooks of the command found, everything it prints going through the sinks the chain resolves
 * @param rootc {*Command} - the root command of the tree
 * @param st {*ParseState} - the scanner both passes already ran over, borrowed
 * @param ctx {*Context} - the context built for this line, borrowed
 * @param perr {error} - what pass two reported, clean when the flags parsed
 * @return the exit code and the error it reported, clean when there was none
 **/
func execRunDispatch(rootc: *Command, st: *ParseState, ctx: *Context, perr: error) -> (int32, error) {
    // The chain, positionals and the command found
    chain: *Vector<*Command> = (*ctx).chain
    pos: *Vector<string> = (*ctx).args
    curc: *Command = (*ctx).cmd

    // Report a flag error
    if perr.exists() {
        return (ctxReportError(chain, curc, perr.message), perr)
    }

    // Print help when it was asked for
    if (*st).helpRequested {
        helpDispatch(ctx)
        return (0, error {})
    }

    // Print the version when it was asked for
    if execVersionRequested(rootc, vec_len(chain)) {
        v: string = novaVersionString(rootc)
        line: string = v + "\n"
        sinkWrite(sinkResolveOut(chain), line)
        free(line)
        free(v)
        return (0, error {})
    }

    // A command without a run either has an unknown word or prints its help
    if !cmdIsRunnable(curc) {
        if vec_len(pos) > 0 {
            return execUnknownCommand(chain, curc, vec_get(pos, 0))
        }
        helpDispatch(ctx)
        return (0, error {})
    }

    // Warn when the command is deprecated
    if (*curc).deprecated != "" {
        warn: string = "Command \"" + (*curc).name + "\" is deprecated, " + (*curc).deprecated + "\n"
        sinkWrite(sinkResolveErr(chain), warn)
        free(warn)
    }

    // Check the required flags, which the builtins and a command that parses no flags of its own skip
    if !(*curc).isBuiltin && !(*curc).disableFlagParsing {
        rerr: error = execCheckRequired(chain)
        if rerr.exists() {
            return (ctxReportError(chain, curc, rerr.message), rerr)
        }
    }

    // Check the flag groups, which the builtins and a command that parses no flags of its own skip
    if !(*curc).isBuiltin && !(*curc).disableFlagParsing {
        gerr: error = execCheckGroups(chain, curc)
        if gerr.exists() {
            return (ctxReportError(chain, curc, gerr.message), gerr)
        }
    }

    // The first positional if any
    mut first: string = ""
    if vec_len(pos) > 0 {
        first = vec_get(pos, 0)
    }

    // Validate the positionals against the command's args rule
    aerr: error = argsValidateFirst((*curc).args, vec_len(pos), first, (*curc).path)
    if aerr.exists() {
        return (ctxReportError(chain, curc, aerr.message), aerr)
    }

    // Run the hook chain of the command found
    return execRunHooks(ctx)
}

/**
 * execDispatch
 * Runs both scanner passes over st, builds the Context the rest of the run shares and then does what argv asked for
 * @param rootc {*Command} - the root command of the tree
 * @param st {*ParseState} - the fresh scanner, borrowed, novaExecuteE frees it after
 * @param argv {string[]} - the raw argv handed to the Context
 * @return the exit code and the error it reported, clean when there was none
 **/
func execDispatch(rootc: *Command, st: *ParseState, argv: string[]) -> (int32, error) {
    // Run both passes of the scanner
    parseFind(st)
    perr: error = parseAll(st)

    // The chain, positionals and the command found
    chain: *Vector<*Command> = (*st).chain
    pos: *Vector<string> = (*st).pos
    curc: *Command = parseCur(st)

    // The context every path from here shares, the leaf, what is left of the line and the chain the sinks and help funcs resolve along
    ctx: *Context = alloc(Context { cmd: curc, root: rootc, chain: chain, args: pos, argv: argv })

    // Do what the line asked for
    code, derr := execRunDispatch(rootc, st, ctx, perr)

    // Free the context now that every hook and help func is done with it
    free(ctx)

    // Return the code and the error already reported
    return (code, derr)
}

/**
 * novaExecuteE
 * Fixes up the tree, finds the command argv names, parses its flags and runs it, handing back the error it reported along with the exit code, the scanner state and the Context live only for this call and are freed before it returns
 * @param rootc {*Command} - the root command of the tree
 * @param argv {string[]} - the raw argv, argv[0] is the program name and is skipped
 * @return the exit code and the error already printed per the silence flags, a clean error after help, the version line and a successful run
 **/
export func novaExecuteE(rootc: *Command, argv: string[]) -> (int32, error) {
    // Fix up the tree before scanning
    execFixup(rootc)

    // The scanner state for this call
    st: *ParseState = parseStateNew(rootc, argv)

    // Scan and run
    code, derr := execDispatch(rootc, st, argv)

    // Free the scanner's chain, pos and toks vectors then the scanner
    parseStateFree(st)
    free(st)

    // Return the exit code and the error the run reported
    return (code, derr)
}

/**
 * novaExecute
 * Runs novaExecuteE and drops the error, which nova has already reported
 * @param rootc {*Command} - the root command of the tree
 * @param argv {string[]} - the raw argv, argv[0] is the program name and is skipped
 * @return the exit code, the handler's return, 0 after help or version, 1 on a usage error
 **/
export func novaExecute(rootc: *Command, argv: string[]) -> int32 {
    // Run the line and drop the error, which was reported as it happened
    code, derr := novaExecuteE(rootc, argv)
    derr.ignore()

    // Return the exit code
    return code
}
