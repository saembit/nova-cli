/**
 * nova/help.dusk
 * Help and usage rendering in the Cobra layout, the builtin help command and the version line
 **/
@paradigm oop
@paradigm procedural

@import std.string
@import std.vector
@import flagset
@import text
@import sink
@import command
@import context

// The gap between the flag column and its description
func helpFlagGap() -> int64 {
    return 3
}

/**
 * novaVersionString
 * Builds the "<name> version <version>" line for the root command
 * @param rootc {*Command} - the root command
 * @return a fresh heap string
 **/
export func novaVersionString(rootc: *Command) -> string {
    return textCat3((*rootc).name, " version ", (*rootc).version)
}

/**
 * helpFlagHelp
 * The description of the synthesized --help flag for a command
 * @param subject {*Command} - the command
 * @return the help text
 **/
export func helpFlagHelp(subject: *Command) -> string {
    return "help for " + (*subject).name
}

/**
 * helpVersionHelp
 * The description of the root's --version flag
 * @param rootc {*Command} - the root command
 * @return the help text
 **/
export func helpVersionHelp(rootc: *Command) -> string {
    return "version for " + (*rootc).name
}

// Orders two flags by long name for vec_sort
func helpFlagCmp(a: *Flag, b: *Flag) -> int32 {
    return str_cmp((*a).name, (*b).name)
}

// The path of the command's parent on the chain, "" for the root
func helpParentPath(chain: *Vector<*Command>) -> string {
    // The root has no parent
    n: int64 = vec_len(chain)
    if n < 2 {
        return ""
    }

    // The entry before the last
    p: *Command = vec_get(chain, n - 2)
    return (*p).path
}

// The use line, parent path plus use plus " [flags]" unless the use already says so
func helpUseLine(subject: *Command, chain: *Vector<*Command>) -> string {
    // The parent path and a builder
    parent: string = helpParentPath(chain)
    sb: *StringBuilder = alloc(sb_new())

    // Push the parent path when there is one
    if parent != "" {
        sb_push(sb, parent)
        sb_push(sb, " ")
    }

    // Push the use and the [flags] marker
    sb_push(sb, (*subject).use)
    if !str_contains((*subject).use, "[flags]") {
        sb_push(sb, " [flags]")
    }

    // Copy the text out and free the builder
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return out
}

// Appends the "Usage:" block with its trailing newline to sb
func helpPushUsage(sb: *StringBuilder, subject: *Command, chain: *Vector<*Command>) -> void {
    // The header
    sb_push(sb, "Usage:\n")

    // The use line when the command runs
    if cmdIsRunnable(subject) {
        sb_push(sb, "  ")
        ul: string = helpUseLine(subject, chain)
        sb_push(sb, ul)
        free(ul)
        sb_push(sb, "\n")
    }

    // The [command] line when it has subcommands
    if subject.hasSubcommands() {
        sb_push(sb, "  ")
        sb_push(sb, (*subject).path)
        sb_push(sb, " [command]\n")
    }
}

// Appends the "Available Commands:" block when the command has visible children
func helpPushCommands(sb: *StringBuilder, subject: *Command) -> void {
    // Nothing to show
    if !subject.hasSubcommands() {
        return
    }

    // The visible children
    shown: *Vector<*Command> = cmdVisibleKids(subject)

    // The widest child name
    mut width: int64 = 0
    mut i: int64 = 0
    while i < vec_len(shown) {
        k: *Command = vec_get(shown, i)
        n: int64 = str_len((*k).name)
        if n > width {
            width = n
        }
        i = i + 1
    }

    // The header
    sb_push(sb, "\nAvailable Commands:\n")

    // One padded line per child
    mut j: int64 = 0
    while j < vec_len(shown) {
        k: *Command = vec_get(shown, j)
        padded: string = textPadRight((*k).name, width + 2)
        sb_push(sb, "  ")
        sb_push(sb, padded)
        sb_push(sb, (*k).short)
        sb_push(sb, "\n")
        free(padded)
        j = j + 1
    }

    // Free the list of shown children, the commands inside are borrowed
    vec_free(shown)
    free(shown)
}

// Checks if a flag named name is already in out
func helpHasFlagNamed(out: *Vector<*Flag>, name: string) -> bool {
    // Loop over the flags collected so far
    mut i: int64 = 0
    while i < vec_len(out) {
        f: *Flag = vec_get(out, i)
        if (*f).name == name {
            return true
        }
        i = i + 1
    }
    return false
}

// Pushes every visible flag of fset onto out, skipping any name already in taken
func helpCollectVisible(out: *Vector<*Flag>, taken: *Vector<string>, fset: *FlagSet) -> void {
    // Loop over the flags in the set
    mut i: int64 = 0
    while i < fset.len() {
        // Claim the name then keep the flag when it is visible
        f: *Flag = fset.get(i)
        if !vec_contains(taken, (*f).name) {
            vec_push(taken, (*f).name)
            if !(*f).hidden && (*f).deprecated == "" {
                vec_push(out, f)
            }
        }
        i = i + 1
    }
}

// The left cell of a flag line, "  -s, --name type" or "      --name type"
func helpFlagCell(f: *Flag) -> string {
    // A builder for the cell
    sb: *StringBuilder = alloc(sb_new())
    sb_push(sb, "  ")

    // The shorthand or its padding
    if (*f).short != "" {
        sb_push(sb, "-")
        sb_push(sb, (*f).short)
        sb_push(sb, ", ")
    } else {
        sb_push(sb, "    ")
    }

    // The long name
    sb_push(sb, "--")
    sb_push(sb, (*f).name)

    // The type word when the kind has one, the alternatives themselves for a choice
    word: string = flagTypeWord(f)
    if word != "" {
        sb_push(sb, " ")
        sb_push(sb, word)
    }
    free(word)

    // Copy the text out and free the builder
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return out
}

// The " (default ...)" suffix of a flag line as a fresh heap string, empty when the default is zero
func helpFlagDefault(f: *Flag) -> string {
    // Pick the suffix by kind
    match (*f).kind {
        KBool => return substring("", 0, 0),
        KStr => {
            if (*f).defS == "" {
                return substring("", 0, 0)
            }
            return textCat3(" (default \"", (*f).defS, "\")")
        },
        KInt => {
            if (*f).defI == 0 {
                return substring("", 0, 0)
            }

            // The number as text, wrapped in the suffix
            n: string = int_to_string((*f).defI)
            out: string = textCat3(" (default ", n, ")")

            // Free the rendered number
            free(n)
            return out
        },
        KFloat => {
            // The float default, rendered the way dusk itself prints one
            x: float64 = (*f).defF
            if x == 0.0 {
                return substring("", 0, 0)
            }

            // The number as text, wrapped in the suffix
            fx: string = f"{x}"
            outf: string = textCat3(" (default ", fx, ")")

            // Free the rendered number
            free(fx)
            return outf
        },
        KStrs => {
            // The default items, printed in the pflag shape with no spaces
            dv: *Vector<string> = (*f).defV
            if vec_len(dv) == 0 {
                return substring("", 0, 0)
            }
            joined: string = str_join(dv, ",")
            outv: string = textCat3(" (default [", joined, "])")
            free(joined)
            return outv
        },
        KCount => return substring("", 0, 0),
        KChoice => {
            if (*f).defS == "" {
                return substring("", 0, 0)
            }
            return textCat3(" (default \"", (*f).defS, "\")")
        },
    }
    return substring("", 0, 0)
}

// Appends one aligned line per flag in flags, which is already sorted, wrapping the descriptions when wrap is set
func helpPushFlagLines(sb: *StringBuilder, flags: *Vector<*Flag>, wrap: int64) -> void {
    // The left cells and the widest one
    cells: *Vector<string> = alloc(vec_new())
    mut width: int64 = 0
    mut i: int64 = 0
    while i < vec_len(flags) {
        cell: string = helpFlagCell(vec_get(flags, i))
        n: int64 = str_len(cell)
        if n > width {
            width = n
        }
        vec_push(cells, cell)
        i = i + 1
    }

    // The column every description starts at, and a wrapped one continues at
    col: int64 = width + helpFlagGap()

    // One padded line per flag
    mut j: int64 = 0
    while j < vec_len(flags) {
        f: *Flag = vec_get(flags, j)
        padded: string = textPadRight(vec_get(cells, j), col)
        suffix: string = helpFlagDefault(f)
        sb_push(sb, padded)

        // The description and its default suffix, wrapped at the column when one is set
        if wrap > 0 {
            text: string = (*f).help + suffix
            textWrapInto(sb, text, wrap, col)
            free(text)
        } else {
            sb_push(sb, (*f).help)
            sb_push(sb, suffix)
        }
        sb_push(sb, "\n")
        free(padded)
        free(suffix)
        j = j + 1
    }

    // Free the cells and their vector
    textFreeStrings(cells)
    vec_free(cells)
    free(cells)
}

// Appends a description paragraph, wrapped at wrap when one is set
func helpPushDesc(sb: *StringBuilder, text: string, wrap: int64) -> void {
    // Wrap it when a column was asked for
    if wrap > 0 {
        textWrapInto(sb, text, wrap, 0)
        return
    }

    // Push it as it stands
    sb_push(sb, text)
}

// Appends the "Flags:" block, the local flags, own persistent flags and the --help line sorted by name
func helpPushFlags(sb: *StringBuilder, subject: *Command, wrap: int64) -> void {
    // The flags to show and the names claimed
    flags: *Vector<*Flag> = alloc(vec_new())
    taken: *Vector<string> = alloc(vec_new())

    // Collect the local flags then the own persistent flags
    localf: *FlagSet = (*subject).flags
    pfl: *FlagSet = (*subject).pflags
    helpCollectVisible(flags, taken, localf)
    helpCollectVisible(flags, taken, pfl)

    // The description of the --help line, which the synthesized flag borrows
    synthHelp: string = helpFlagHelp(subject)

    // Synthesize the --help flag when none is declared, the set lives until the lines are pushed
    synth: *FlagSet = flagsetNew()
    if !vec_contains(taken, "help") {
        synth.addBool("help", "h", false, synthHelp)
        vec_push(flags, synth.get(0))
    }

    // Sort and append the lines
    vec_sort(flags, helpFlagCmp)
    sb_push(sb, "\nFlags:\n")
    helpPushFlagLines(sb, flags, wrap)

    // Free the synthesized set, its description and the two vectors, the flags and names inside are borrowed
    synth.freeAll()
    free(synth)
    free(synthHelp)
    vec_free(flags)
    free(flags)
    vec_free(taken)
    free(taken)
}

// Appends the "Global Flags:" block, the ancestors' persistent flags minus the names the leaf defines
func helpPushGlobalFlags(sb: *StringBuilder, chain: *Vector<*Command>, wrap: int64) -> void {
    // The flags to show and the names claimed
    flags: *Vector<*Flag> = alloc(vec_new())
    taken: *Vector<string> = alloc(vec_new())

    // The leaf on the chain
    n: int64 = vec_len(chain)
    leaf: *Command = vec_get(chain, n - 1)

    // Claim the names of the leaf's own flags
    own: *Vector<*Flag> = alloc(vec_new())
    localf: *FlagSet = (*leaf).flags
    pfl: *FlagSet = (*leaf).pflags
    helpCollectVisible(own, taken, localf)
    helpCollectVisible(own, taken, pfl)

    // Collect the ancestors' persistent flags, nearest first
    mut i: int64 = n - 2
    while i >= 0 {
        c: *Command = vec_get(chain, i)
        pf: *FlagSet = (*c).pflags
        helpCollectVisible(flags, taken, pf)
        i = i - 1
    }

    // Sort and append the lines when there is something to show
    if vec_len(flags) > 0 {
        vec_sort(flags, helpFlagCmp)
        sb_push(sb, "\nGlobal Flags:\n")
        helpPushFlagLines(sb, flags, wrap)
    }

    // Free the three vectors, the flags and names inside are borrowed
    vec_free(own)
    free(own)
    vec_free(flags)
    free(flags)
    vec_free(taken)
    free(taken)
}

/**
 * helpRender
 * Builds the full help text for subject in the Cobra layout, ending with a newline
 * @param subject {*Command} - the command to describe
 * @param chain {*Vector<*Command>} - the commands root..subject
 * @return a fresh heap string
 **/
export func helpRender(subject: *Command, chain: *Vector<*Command>) -> string {
    return helpRenderParts(subject, chain, true)
}

/**
 * helpRenderUsage
 * Builds the usage text for subject, the help text without the leading description
 * @param subject {*Command} - the command to describe
 * @param chain {*Vector<*Command>} - the commands root..subject
 * @return a fresh heap string
 **/
export func helpRenderUsage(subject: *Command, chain: *Vector<*Command>) -> string {
    return helpRenderParts(subject, chain, false)
}

/**
 * helpRenderParts
 * The shared renderer behind helpRender and helpRenderUsage
 * @param subject {*Command} - the command to describe
 * @param chain {*Vector<*Command>} - the commands root..subject
 * @param withDesc {bool} - whether the description goes on top
 * @return a fresh heap string
 **/
func helpRenderParts(subject: *Command, chain: *Vector<*Command>, withDesc: bool) -> string {
    // A builder for the text
    sb: *StringBuilder = alloc(sb_new())

    // The column the text is wrapped at, 0 when nothing on the chain asks for wrapping
    wrap: int64 = cmdResolveWrapWidth(chain)

    // The long or short description on top
    if withDesc {
        if (*subject).long != "" {
            helpPushDesc(sb, (*subject).long, wrap)
            sb_push(sb, "\n\n")
        } else if (*subject).short != "" {
            helpPushDesc(sb, (*subject).short, wrap)
            sb_push(sb, "\n\n")
        }
    }

    // The Usage block
    helpPushUsage(sb, subject, chain)

    // The Aliases block
    aliases: *Vector<string> = (*subject).aliases
    if vec_len(aliases) > 0 {
        sb_push(sb, "\nAliases:\n  ")
        sb_push(sb, (*subject).name)
        mut i: int64 = 0
        while i < vec_len(aliases) {
            sb_push(sb, ", ")
            sb_push(sb, vec_get(aliases, i))
            i = i + 1
        }
        sb_push(sb, "\n")
    }

    // The Examples block
    if (*subject).example != "" {
        sb_push(sb, "\nExamples:\n")
        sb_push(sb, (*subject).example)
        sb_push(sb, "\n")
    }

    // The commands and flag blocks
    helpPushCommands(sb, subject)
    helpPushFlags(sb, subject, wrap)
    helpPushGlobalFlags(sb, chain, wrap)

    // The footer when it has subcommands
    if subject.hasSubcommands() {
        sb_push(sb, "\nUse \"")
        sb_push(sb, (*subject).path)
        sb_push(sb, " [command] --help\" for more information about a command.\n")
    }

    // Copy the text out and free the builder
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return out
}

/**
 * helpPrint
 * Writes the help text for subject to the out sink of the chain
 * @param subject {*Command} - the command to describe
 * @param chain {*Vector<*Command>} - the commands root..subject
 * @return ...
 **/
export func helpPrint(subject: *Command, chain: *Vector<*Command>) -> void {
    // Render, write and free
    s: string = helpRender(subject, chain)
    sinkWrite(sinkResolveOut(chain), s)
    free(s)
}

/**
 * usagePrint
 * Writes the usage text for subject to the err sink of the chain, what Cobra shows after "Unknown help topic"
 * @param subject {*Command} - the command
 * @param chain {*Vector<*Command>} - the commands root..subject
 * @return ...
 **/
export func usagePrint(subject: *Command, chain: *Vector<*Command>) -> void {
    // Render, write and free, the text already ends in a newline
    s: string = helpRenderUsage(subject, chain)
    sinkWrite(sinkResolveErr(chain), s)
    free(s)
}

/**
 * helpDispatch
 * Prints the help of the command ctx names, through the nearest help func on its chain or the default renderer
 * @param ctx {*Context} - the context naming the command help was asked for
 * @return ...
 **/
export func helpDispatch(ctx: *Context) -> void {
    // The chain the help func is resolved along
    chain: *Vector<*Command> = (*ctx).chain

    // The nearest command carrying a help func
    i: int64 = cmdNearestHelpFunc(chain)

    // Hand the context to it when there is one
    if i >= 0 {
        c: *Command = vec_get(chain, i)
        f := (*c).helpFunc
        f(ctx)
        return
    }

    // Otherwise render the help the default way
    helpPrint((*ctx).cmd, chain)
}

/**
 * usageDispatch
 * Prints the usage block of the command ctx names, through the nearest usage func on its chain or the default renderer
 * @param ctx {*Context} - the context naming the command usage was asked for
 * @return ...
 **/
export func usageDispatch(ctx: *Context) -> void {
    // The chain the usage func is resolved along
    chain: *Vector<*Command> = (*ctx).chain

    // The nearest command carrying a usage func
    i: int64 = cmdNearestUsageFunc(chain)

    // Hand the context to it when there is one
    if i >= 0 {
        c: *Command = vec_get(chain, i)
        f := (*c).usageFunc
        f(ctx)
        return
    }

    // Otherwise render the usage block the default way
    usagePrint((*ctx).cmd, chain)
}

// The handler of the builtin help command, walks ctx.args as a child path from the root for as long as the words match
func helpCommandRun(ctx: *Context) -> int32 {
    // The root and the words after help
    rootc: *Command = (*ctx).root
    words: *Vector<string> = (*ctx).args

    // The chain walked so far, starting at the root
    chain: *Vector<*Command> = alloc(vec_new())
    vec_push(chain, rootc)

    // Descend while each word names a child
    mut i: int64 = 0
    mut matching: bool = true
    while matching && i < vec_len(words) {
        curc: *Command = vec_get(chain, vec_len(chain) - 1)
        j: int64 = curc.findChild(vec_get(words, i))
        if j < 0 {
            matching = false
        } else {
            vec_push(chain, curc.child(j))
            i = i + 1
        }
    }

    // The deepest command matched
    last: *Command = vec_get(chain, vec_len(chain) - 1)

    // Words left over under a command with subcommands is an unknown topic
    if i < vec_len(words) && last.numChildren() > 0 {
        joined: string = str_join(words, " ")
        line: string = textCat3("Unknown help topic [", joined, "]\n")
        sinkWrite(sinkResolveErr((*ctx).chain), line)
        free(line)
        free(joined)
        rootchain: *Vector<*Command> = alloc(vec_new())
        vec_push(rootchain, rootc)

        // The usage of the root goes through its usage func when it has one, the way Cobra calls Root().Usage()
        uctx: *Context = alloc(Context { cmd: rootc, root: rootc, chain: rootchain, args: words, argv: (*ctx).argv })
        usageDispatch(uctx)

        // Free the context and both chains
        free(uctx)
        vec_free(rootchain)
        free(rootchain)
        vec_free(chain)
        free(chain)
        return 1
    }

    // The context the help of the command matched is printed against, its own chain and the words that named it
    hctx: *Context = alloc(Context { cmd: last, root: rootc, chain: chain, args: words, argv: (*ctx).argv })

    // Print the help through the nearest help func or the default renderer
    helpDispatch(hctx)

    // Free the context built for it and the chain
    free(hctx)
    vec_free(chain)
    free(chain)
    return 0
}

/**
 * helpCommandNew
 * Builds the builtin help [command] command novaExecute adds to a root with subcommands
 * @param appName {string} - the root command's name, used in the long description
 * @return the new command
 **/
export func helpCommandNew(appName: string) -> *Command {
    // The command with its use and short
    c: *Command = cmdNew("help [command]", "Help about any command")

    // The long description as one owned string, which the tree frees along with the command
    long: string = textCat3("Help provides help for any command in the application.\nSimply type ", appName, " help [path to command] for full details.")
    c.setLong(long)
    (*c).longOwned = true

    // The handler
    c.setRun(helpCommandRun)

    // Mark it builtin so inherited required flags skip it
    (*c).isBuiltin = true
    return c
}
