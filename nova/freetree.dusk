/**
 * nova/freetree.dusk
 * novaFreeTree, frees a whole Command tree once the run is over, every node reachable from the root along with its vectors, its flag groups and both of its FlagSets, the strings are left alone since they are borrowed literals or argv, apart from the group names, the name cmdNew cut out of the use line, the paths the executor built and the last error message, which the tree owns
 * The walk is a worklist taken from the back rather than recursion, a node is freed after its children are queued so no child is reached through a freed parent
 **/
@paradigm oop
@paradigm procedural

@import std.vector
@import flagset
@import flaggroup
@import command

/**
 * freetreeFields
 * Frees what one Command node owns, its name, its path and last error message, its aliases, validArgs, kids, completion func and groups vectors and both FlagSets, the node itself is left for its owner and the children must already be queued elsewhere since the kids vector goes too
 * @param n {*Command} - the node whose fields to free
 * @return nothing
 **/
func freetreeFields(n: *Command) -> void {
    // Free the long description when the builtin that built it owns it
    if (*n).longOwned {
        free((*n).long)
    }

    // Free the path the executor built for this node, which only the root does not own
    if (*n).pathOwned {
        free((*n).path)
    }

    // Free the name cmdNew cut out of the use line, which the root's path also points at
    free((*n).name)

    // Free the message of the last error nova reported through this node
    if (*n).hasErrMsg {
        free((*n).errMsg)
    }

    // Free the alias vector
    vec_free((*n).aliases)
    free((*n).aliases)

    // Free the valid arg vector
    vec_free((*n).validArgs)
    free((*n).validArgs)

    // Free the child vector, the children themselves are on the worklist
    vec_free((*n).kids)
    free((*n).kids)

    // The flag completion func registry
    comps: *Vector<*FlagCompFunc> = (*n).compFuncs

    // Loop taking entries off the back, the name inside one is borrowed and stays
    while vec_len(comps) > 0 {
        // The last entry, now owned here
        e: *FlagCompFunc = vec_take(comps, vec_len(comps) - 1)

        // Free the entry
        free(e)
    }

    // Free the registry vector
    vec_free(comps)
    free((*n).compFuncs)

    // Free the flags in the local set then the set
    lf: *FlagSet = (*n).flags
    lf.freeAll()
    free((*n).flags)

    // Free the flags in the persistent set then the set
    pf: *FlagSet = (*n).pflags
    pf.freeAll()
    free((*n).pflags)

    // The flag group vector
    groups: *Vector<*FlagGroup> = (*n).groups

    // Loop taking groups off the back
    while vec_len(groups) > 0 {
        // The last group, now owned here
        g: *FlagGroup = vec_take(groups, vec_len(groups) - 1)

        // The names the group owns
        gnames: *Vector<string> = (*g).names

        // Loop taking names off the back
        while vec_len(gnames) > 0 {
            // The last name, a heap string the group owns
            nm: string = vec_take(gnames, vec_len(gnames) - 1)

            // Free the name
            free(nm)
        }

        // Free the name vector then the group
        vec_free(gnames)
        free((*g).names)
        free(g)
    }

    // Free the group vector
    vec_free(groups)
    free((*n).groups)
}

/**
 * novaFreeTree
 * Frees every Command reachable from rootc, the root included, along with each node's vectors, flag groups and FlagSets, the builtin help and completion commands and the --version flag novaExecute added are nodes and flags like any other so they go too, nothing in the tree may be used after this returns
 * @param rootc {*Command} - the root of the tree to free
 * @return nothing
 **/
export func novaFreeTree(rootc: *Command) -> void {
    // The worklist of commands still to free, starting at the root
    work: *Vector<*Command> = alloc(vec_new())
    vec_push(work, rootc)

    // Loop taking nodes off the back until none are left
    while vec_len(work) > 0 {
        // The last node, now owned here
        n: *Command = vec_take(work, vec_len(work) - 1)

        // The node's child vector
        kids: *Vector<*Command> = (*n).kids

        // Queue every child before the node goes
        mut i: int64 = 0
        while i < vec_len(kids) {
            vec_push(work, vec_get(kids, i))
            i = i + 1
        }

        // Free what the node owns then the node
        freetreeFields(n)
        free(n)
    }

    // Free the worklist
    vec_free(work)
    free(work)
}
