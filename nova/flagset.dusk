        }
    }

    /**
     * bindEnv
     * Binds name to one environment variable by its exact spelling, which wins over the name a command's env prefix would give it, aborts when it is not declared
     * @param name {string} - the long name
     * @param varName {string} - the environment variable, borrowed
     * @return nothing
     **/
    func bindEnv(name: string, varName: string) -> void {
        // Bind it and abort on a refusal
        e: error = self.tryBindEnv(name, varName)
        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

    /**
     * trySource
     * Gives where the value of name came from
     * @param name {string} - the long name
     * @return the source and a clean error, or SDefault and "no flag named '--name'"
     **/
    func trySource(name: string) -> (FlagSource, error) {
        // The flag, or the error naming it as missing
        i, e := self.findE(name)
        if e.exists() {
            return (FlagSource.SDefault, e)
        }

        // Return the source
        return ((*self.get(i)).source, error {})
    }

    /**
     * tryGetBool
     * Gives the value of the bool flag name
     * @param name {string} - the long name
     * @return the value and a clean error, or false and "no bool flag named '--name'"
     **/
    func tryGetBool(name: string) -> (bool, error) {
        // The flag checked for kind
        i, e := self.findKindE(name, FlagKind.KBool, "bool")
        if e.exists() {
            return (false, e)
        }

        // Return the bool value
        return ((*self.get(i)).valB, error {})
    }

    /**
     * tryGetStr
     * Gives the value of the string or choice flag name
     * @param name {string} - the long name
     * @return the value and a clean error, or "" and "no string flag named '--name'"
     **/
    func tryGetStr(name: string) -> (string, error) {
        // The flag checked for kind, a string or a choice
        i, e := self.findStrLikeE(name)
        if e.exists() {
            return ("", e)
        }

        // Return the string value
        return ((*self.get(i)).valS, error {})
    }

    /**
     * tryGetInt
     * Gives the value of the int flag name
     * @param name {string} - the long name
     * @return the value and a clean error, or 0 and "no int flag named '--name'"
     **/
    func tryGetInt(name: string) -> (int64, error) {
        // The flag checked for kind
        i, e := self.findKindE(name, FlagKind.KInt, "int")
        if e.exists() {
            return (0, e)
        }

        // Return the int value
        return ((*self.get(i)).valI, error {})
    }

    /**
     * tryGetFloat
     * Gives the value of the float flag name
     * @param name {string} - the long name
     * @return the value and a clean error, or 0.0 and "no float flag named '--name'"
     **/
    func tryGetFloat(name: string) -> (float64, error) {
        // The flag checked for kind
        i, e := self.findKindE(name, FlagKind.KFloat, "float")
        if e.exists() {
            return (0.0, e)
        }

        // Return the float value
        return ((*self.get(i)).valF, error {})
    }

    /**
     * tryGetStrs
     * Gives the items of the string slice flag name
     * @param name {string} - the long name
     * @return the items, borrowed and never freed by the caller, and a clean error, or an empty list the set owns and "no strings flag named '--name'"
     **/
    func tryGetStrs(name: string) -> (*Vector<string>, error) {
        // The flag checked for kind
        i, e := self.findKindE(name, FlagKind.KStrs, "strings")
        if e.exists() {
            return (self.none, e)
        }

        // Return the value list
        return ((*self.get(i)).valV, error {})
    }

    /**
     * tryGetCount
     * Gives how many times the count flag name was named
     * @param name {string} - the long name
     * @return the count and a clean error, or 0 and "no count flag named '--name'"
     **/
    func tryGetCount(name: string) -> (int64, error) {
        // The flag checked for kind
        i, e := self.findKindE(name, FlagKind.KCount, "count")
        if e.exists() {
            return (0, e)
        }

        // Return the count
        return ((*self.get(i)).valI, error {})
    }

    /**
     * tryChanged
     * Checks if name was set on the command line
     * @param name {string} - the long name
     * @return the answer and a clean error, or false and "no flag named '--name'"
     **/
    func tryChanged(name: string) -> (bool, error) {
        // The flag, or the error naming it as missing
        i, e := self.findE(name)
        if e.exists() {
            return (false, e)
        }

        // Return the changed bit
        return ((*self.get(i)).changed, error {})
    }

    /**
     * source
     * Gives where the value of name came from, aborts when it is not declared
     * @param name {string} - the long name
     * @return the source, SDefault when nothing set it
     **/
    func source(name: string) -> FlagSource {
        // The source, aborting on a refusal
        s, e := self.trySource(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return s
    }

