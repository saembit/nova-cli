/**
 * nova/flagset.dusk
 * The flags a command declares, a FlagSet is a registry of bool, string, int, float, string slice, count and choice flags with optional one character shorthands, looked up by long name or shorthand and set from raw command line text one token at a time by the executor
 * Bad input is an error value the executor reports, misuse of the library such as a duplicate flag, a getter on the wrong kind, etc. is an error value from the try forms (tryAddStr, tryGetStr, tryMarkRequired, ...) and aborts with "fatal: nova: ..." on stderr from the plain forms, which are thin wrappers over them
 **/
@paradigm oop
@paradigm procedural

@import std.string
@import std.vector
@import text
@import number

/**
 * FlagKind
 * The value shapes a flag can carry
 **/
export enum FlagKind { KBool, KStr, KInt, KFloat, KStrs, KCount, KChoice }

/**
 * FlagSource
 * Where the value a flag carries came from, the four listed in rising precedence so a later one overwrites an earlier one and never the other way round
 **/
export enum FlagSource { SDefault, SConfig, SEnv, SLine }

/**
 * Flag
 * One declared flag, only the def and val pair matching kind is meaningful and the others hold zero values, the plain strings are borrowed from the caller's literals or argv and never freed here while every string inside defV, valV and choices is a fresh heap copy the flag owns
 * A string or choice value is copied into held, the one plain string the flag does own, since the token, environment variable or config file it was read from goes away as soon as the run is done with it
 **/
export struct Flag {
    name: string,
    short: string,
    kind: FlagKind,
    help: string,
    defB: bool,
    defS: string,
    defI: int64,
    defF: float64,
    valB: bool,
    valS: string,
    valI: int64,
    valF: float64,
    defV: *Vector<string>,
    valV: *Vector<string>,
    choices: *Vector<string>,
    changed: bool,
    required: bool,
    hidden: bool,
    deprecated: string,
    env: string,
    source: FlagSource,
    held: string,
    hasHeld: bool,
}

/**
 * FlagSet
 * A set of flags in declaration order, build with flagsetNew() and pass by pointer, freeAll frees the flags and the item vector and the owner frees the set itself, novaFreeTree does both for every set in a tree
 * none is an empty list the set owns and never fills, what tryGetStrs hands back beside its error so the caller always gets a vector it can read
 **/
export struct FlagSet {
    items: *Vector<*Flag>,
    none: *Vector<string>,
}

/**
 * flagsetNew
 * Makes a fresh empty heap FlagSet
 * @return a pointer to the new set
 **/
export func flagsetNew() -> *FlagSet {
    // The empty item vector
    v: *Vector<*Flag> = alloc(vec_new())

    // The empty list a failed tryGetStrs hands back
    none: *Vector<string> = alloc(vec_new())

    // Return the new set
    return alloc(FlagSet { items: v, none: none })
}

/**
 * flagKindWord
 * Gives the type word help prints after a flag name, "" for the kinds that take no value and a static word for the rest, a choice has no word of its own since it prints its own alternatives
 * @param k {FlagKind} - the kind
 * @return a static literal
 **/
export func flagKindWord(k: FlagKind) -> string {
    // Pick the word by kind
    match k {
        KBool => return "",
        KStr => return "string",
        KInt => return "int",
        KFloat => return "float",
        KStrs => return "strings",
        KCount => return "",
        KChoice => return "",
    }
}

// The position of a kind in the enum, the number two kinds are compared by
func flagKindIndex(k: FlagKind) -> int64 {
    // Pick the position by kind
    match k {
        KBool => return 0,
        KStr => return 1,
        KInt => return 2,
        KFloat => return 3,
        KStrs => return 4,
        KCount => return 5,
        KChoice => return 6,
    }
}

/**
 * flagKindEq
 * Checks if two kinds are the same variant since enums do not compare with ==
 * @param a {FlagKind} - the first kind
 * @param b {FlagKind} - the second kind
 * @return true when they match
 **/
export func flagKindEq(a: FlagKind, b: FlagKind) -> bool {
    // Compare the two positions
    return flagKindIndex(a) == flagKindIndex(b)
}

/**
 * flagSourceWord
 * Gives the word that names where a value came from, what a handler prints when it wants to show the precedence a run settled on
 * @param s {FlagSource} - the source
 * @return a static literal, "default", "config", "env" or "flag"
 **/
export func flagSourceWord(s: FlagSource) -> string {
    // Pick the word by source
    match s {
        SDefault => return "default",
        SConfig => return "config",
        SEnv => return "env",
        SLine => return "flag",
    }
}

// The position of a source in the enum, the number two sources are compared by
func flagSourceIndex(s: FlagSource) -> int64 {
    // Pick the position by source
    match s {
        SDefault => return 0,
        SConfig => return 1,
        SEnv => return 2,
        SLine => return 3,
    }
}

/**
 * flagSourceEq
 * Checks if two sources are the same variant since enums do not compare with ==
 * @param a {FlagSource} - the first source
 * @param b {FlagSource} - the second source
 * @return true when they match
 **/
export func flagSourceEq(a: FlagSource, b: FlagSource) -> bool {
    // Compare the two positions
    return flagSourceIndex(a) == flagSourceIndex(b)
}

/**
 * flagIsSet
 * Checks if anything at all gave the flag its value, the command line, the environment or a config file, the test the required check and the flag groups run
 * @param f {*Flag} - the flag, borrowed
 * @return true when the value is not the declared default
 **/
export func flagIsSet(f: *Flag) -> bool {
    // Anything but the default counts
    return !flagSourceEq((*f).source, FlagSource.SDefault)
}

/**
 * flagEnvVarName
 * Builds the environment variable a prefix and a long flag name name together, the long name upper cased with every dash turned into an underscore
 * @param prefix {string} - the application prefix without its trailing underscore, borrowed
 * @param name {string} - the long flag name, borrowed
 * @return a fresh heap string such as "APP_LOG_LEVEL"
 **/
export func flagEnvVarName(prefix: string, name: string) -> string {
    // The name upper cased
    up: string = to_upper(name)

    // The dashes a flag name may carry turned into underscores
    us: string = replace_all(up, "-", "_")

    // The prefix and the name under one underscore
    out: string = textCat3(prefix, "_", us)

    // Free the two working copies
    free(us)
    free(up)

    // Return the variable name
    return out
}

/**
 * flagTakesValue
 * Checks if a flag consumes a value token, every kind but bool and count does
 * @param f {*Flag} - the flag, borrowed
 * @return true when the flag wants a value
 **/
export func flagTakesValue(f: *Flag) -> bool {
    // A bool is set by being there
    if flagKindEq((*f).kind, FlagKind.KBool) {
        return false
    }

    // A count is counted by being there
    if flagKindEq((*f).kind, FlagKind.KCount) {
        return false
    }

    // Everything else wants a value
    return true
}

/**
 * flagTypeWord
 * Gives the type word help prints after a flag name, the kind word for most flags and the alternatives joined with "|" for a choice
 * @param f {*Flag} - the flag, borrowed
 * @return a fresh heap string, empty for the kinds with no word
 **/
export func flagTypeWord(f: *Flag) -> string {
    // A choice prints its own alternatives
    if flagKindEq((*f).kind, FlagKind.KChoice) {
        // The alternatives in declaration order
        ch: *Vector<string> = (*f).choices

        // Join them with bars
        return str_join(ch, "|")
    }

    // The static word of the kind
    w: string = flagKindWord((*f).kind)

    // Return a copy of it so every caller frees the same way
    return substring(w, 0, str_len(w))
}

/**
 * flagParseBool
 * Parses a boolean word the way "--flag=value" accepts it, true/false, 1/0, t/f, yes/no, y/n, case insensitive
 * @param raw {string} - the text, borrowed
 * @return the value and an error, the error message is "expected a boolean" on bad text
 **/
export func flagParseBool(raw: string) -> (bool, error) {
    // The lower cased text
    low: string = to_lower(raw)

    // Whether the text matched and the value it gave
    mut ok: bool = false
    mut val: bool = false

    // Check the true words then the false words
    if low == "true" || low == "1" || low == "t" || low == "yes" || low == "y" {
        ok = true
        val = true
    } else if low == "false" || low == "0" || low == "f" || low == "no" || low == "n" {
        ok = true
        val = false
    }

    // Free the lower cased copy
    free(low)

    // Return the value on a match
    if ok {
        return (val, error {})
    }

    // Return the error for bad text
    return (false, error { message: "expected a boolean" })
}

/**
 * flagInvalidArg
 * Builds the Cobra style invalid argument "raw" for "--name" flag: <why> error
 * @param raw {string} - the bad text
 * @param name {string} - the long flag name
 * @param why {string} - the reason
 * @return the error holding the message
 **/
func flagInvalidArg(raw: string, name: string, why: string) -> error {
    // The quoted raw text
    q: string = textQuote(raw)

    // The message up to the reason
    head: string = textCat5("invalid argument ", q, " for \"--", name, "\" flag: ")

    // The reason after it
    msg: string = head + why

    // Free the quoted copy and the halfway result
    free(head)
    free(q)

    // Return the error with the message
    return error { message: msg }
}

/**
 * flagMake
 * Makes a fresh heap Flag of the given kind with its value set to its default
 * @param name {string} - the long name
 * @param short {string} - the shorthand or ""
 * @param kind {FlagKind} - the kind
 * @param help {string} - the help text
 * @param defB {bool} - the bool default
 * @param defS {string} - the string default
 * @param defI {int64} - the int default
 * @param defF {float64} - the float default
 * @return a pointer to the new flag
 **/
func flagMake(name: string, short: string, kind: FlagKind, help: string, defB: bool, defS: string, defI: int64, defF: float64) -> *Flag {
    // The default list, the value list and the choice list, empty until a kind that uses them fills them
    dv: *Vector<string> = alloc(vec_new())
    vv: *Vector<string> = alloc(vec_new())
    ch: *Vector<string> = alloc(vec_new())

    // Return the new flag with the value equal to the default
    return alloc(Flag {
        name: name, short: short, kind: kind, help: help,
        defB: defB, defS: defS, defI: defI, defF: defF,
        valB: defB, valS: defS, valI: defI, valF: defF,
        defV: dv, valV: vv, choices: ch,
        changed: false, required: false, hidden: false, deprecated: "",
        env: "", source: FlagSource.SDefault, held: "", hasHeld: false,
    })
}

/**
 * flagDropHeld
 * Frees the copy an env or config value left on the flag, leaving it holding none
 * @param f {*Flag} - the flag, borrowed
 * @return nothing
 **/
export func flagDropHeld(f: *Flag) -> void {
    // Nothing was copied so nothing to free
    if !(*f).hasHeld {
        return
    }

    // Free the copy and forget it
    free((*f).held)
    (*f).held = ""
    (*f).hasHeld = false
}

// Makes the string value of f a fresh copy of raw the flag itself owns, since the token or variable it was read from goes away
func flagHold(f: *Flag, raw: string) -> void {
    // Drop whatever an earlier apply left
    flagDropHeld(f)

    // The copy the flag keeps
    c: string = substring(raw, 0, str_len(raw))

    // Point both the held slot and the value at it
    (*f).held = c
    (*f).hasHeld = true
    (*f).valS = c
}

// Frees the three string lists a flag owns along with their vectors and the one plain string it may own
func flagFreeLists(f: *Flag) -> void {
    // The copy an env or config value left behind
    flagDropHeld(f)

    // The default list
    dv: *Vector<string> = (*f).defV
    textFreeStrings(dv)
    vec_free(dv)
    free((*f).defV)

    // The value list
    vv: *Vector<string> = (*f).valV
    textFreeStrings(vv)
    vec_free(vv)
    free((*f).valV)

    // The choice list
    ch: *Vector<string> = (*f).choices
    textFreeStrings(ch)
    vec_free(ch)
    free((*f).choices)
}

/**
 * flagStore
 * Parses raw per the kind of f and stores it, the shared half of every setter, leaving the changed bit and the source to the caller that knows where the text came from
 * @param f {*Flag} - the flag, borrowed
 * @param raw {string} - the text to parse
 * @param fresh {bool} - true when the value replaces whatever is there rather than adding to it, which is what everything but a repeated string slice on the command line does
 * @return a clean error, or the Cobra style invalid argument message
 **/
func flagStore(f: *Flag, raw: string, fresh: bool) -> error {
    // Parse and store by kind
    match (*f).kind {
        KBool => {
            // Parse the bool word
            b, e := flagParseBool(raw)
            if e.exists() {
                return flagInvalidArg(raw, (*f).name, "expected a boolean")
            }
            (*f).valB = b
        },
        KStr => {
            // Keep a copy of the text as the value, since the token it came in is a temporary
            flagHold(f, raw)
        },
        KInt => {
            // Parse the int under the grammar number.dusk states
            n, e := textParseInt(raw)
            if e.exists() {
                return flagInvalidArg(raw, (*f).name, e.message)
            }
            (*f).valI = n
        },
        KFloat => {
            // Parse the number under the grammar number.dusk states
            x, e := textParseFloat(raw)
            if e.exists() {
                return flagInvalidArg(raw, (*f).name, e.message)
            }
            (*f).valF = x
        },
        KStrs => {
            // The first occurrence on the line drops the default, every later one appends, and a value from elsewhere always starts over
            if fresh || !(*f).changed {
                textFreeStrings((*f).valV)
            }

            // Split the text on commas onto the end of the value list
            textPushCommas((*f).valV, raw)
        },
        KCount => {
            // Parse the count the "=N" form carries, under the same grammar an int takes
            n, e := textParseInt(raw)
            if e.exists() {
                return flagInvalidArg(raw, (*f).name, e.message)
            }
            (*f).valI = n
        },
        KChoice => {
            // The alternatives this flag was declared with
            ch: *Vector<string> = (*f).choices

            // A value outside them is the invalid argument error
            if !vec_contains(ch, raw) {
                // The alternatives quoted and joined the way the message lists them
                joined: string = textJoinQuoted(ch, ", ")

                // The reason and the error built around it
                why: string = "must be one of " + joined
                e2: error = flagInvalidArg(raw, (*f).name, why)

                // Free the two built strings
                free(why)
                free(joined)
                return e2
            }

            // Keep a copy of the text as the value, since the token it came in is a temporary
            flagHold(f, raw)
        },
    }

    // Nothing went wrong
    return error {}
}

/**
 * flagApplyValue
 * Parses raw per the kind of f and stores it as a value that did not come from the command line, recording where it did come from and leaving the changed bit alone
 * @param f {*Flag} - the flag, borrowed
 * @param raw {string} - the text from the environment or a config file, borrowed and copied where the kind keeps a string
 * @param src {FlagSource} - SEnv or SConfig, whichever is applying the value
 * @return a clean error, or the same invalid argument message the command line would have earned
 **/
export func flagApplyValue(f: *Flag, raw: string, src: FlagSource) -> error {
    // Parse and store the text, keeping a copy of it where the kind holds a string
    e: error = flagStore(f, raw, true)

    // A value the kind refuses leaves the flag as it was
    if e.exists() {
        return e
    }

    // Record where the value came from
    (*f).source = src

    // Nothing went wrong
    return error {}
}

/**
 * flagApplyStrs
 * Replaces the items of a string slice flag with fresh copies of items, what a config file's JSON array gives rather than a comma separated line
 * @param f {*Flag} - the flag, borrowed, declared as a string slice
 * @param items {*Vector<string>} - the items, borrowed and copied one by one
 * @param src {FlagSource} - SEnv or SConfig, whichever is applying the value
 * @return nothing
 **/
export func flagApplyStrs(f: *Flag, items: *Vector<string>, src: FlagSource) -> void {
    // The value list, which starts over rather than growing
    vv: *Vector<string> = (*f).valV
    textFreeStrings(vv)

    // Loop over the items in order
    mut i: int64 = 0
    while i < vec_len(items) {
        // The current item copied onto the value list
        it: string = vec_get(items, i)
        vec_push(vv, substring(it, 0, str_len(it)))
        i = i + 1
    }

    // Record where the value came from
    (*f).source = src
}

/**
 * flagNameShapeErr
 * Checks a long name and a shorthand have a shape the parser can reach, a long name is not empty, does not start with a dash and holds no "=", a shorthand is "" or one byte that is not a dash, an "=" or a digit
 * @param name {string} - the long name, borrowed
 * @param short {string} - the shorthand or "", borrowed
 * @return a clean error, or the reason the shape is refused
 **/
export func flagNameShapeErr(name: string, short: string) -> error {
    // An empty long name could never be typed
    if name == "" {
        return error { message: textCat3("flag with an empty name", "", "") }
    }

    // A leading dash or an "=" would be read as syntax rather than as the name
    if starts_with(name, "-") || str_contains(name, "=") {
        return error { message: textCat3("flag name '", name, "' starts with a dash or holds an \"=\"") }
    }

    // No shorthand is always fine
    if short == "" {
        return error {}
    }

    // The shorthand must be one character
    if !textIsOneChar(short) {
        return error { message: textCat3("shorthand for flag '--", name, "' must be one character") }
    }

    // A dash, an "=" or a digit is read as something else in a cluster
    if short == "-" || short == "=" || textIsDigit(short[0]) {
        head: string = textCat3("shorthand '", short, "' for flag '--")
        msg: string = textCat3(head, name, "' cannot be parsed")
        free(head)
        return error { message: msg }
    }

    // The shape is fine
    return error {}
}

impl FlagSet {
    /**
     * len
     * Gives the number of flags declared
     * @return the count
     **/
    func len() -> int64 {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Return the length
        return vec_len(items)
    }

    /**
     * get
     * Gives the flag at index i, aborts when out of range
     * @param i {int64} - the index
     * @return the flag
     **/
    func get(i: int64) -> *Flag {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Return the flag at i
        return vec_get(items, i)
    }

    /**
     * find
     * Finds the index of the flag with long name name
     * @param name {string} - the long name
     * @return the index or -1
     **/
    func find(name: string) -> int64 {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop over the flags in the set
        mut i: int64 = 0
        while i < vec_len(items) {
            // The current flag
            f: *Flag = vec_get(items, i)

            // Return the index on a name match
            if (*f).name == name {
                return i
            }
            i = i + 1
        }

        // Not found
        return -1
    }

    /**
     * findShort
     * Finds the index of the flag with shorthand short, "" never matches
     * @param short {string} - the shorthand
     * @return the index or -1
     **/
    func findShort(short: string) -> int64 {
        // An empty shorthand matches nothing
        if short == "" {
            return -1
        }

        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop over the flags in the set
        mut i: int64 = 0
        while i < vec_len(items) {
            // The current flag
            f: *Flag = vec_get(items, i)

            // Return the index on a shorthand match
            if (*f).short == short {
                return i
            }
            i = i + 1
        }

        // Not found
        return -1
    }

    /**
     * has
     * Checks if a flag with long name name exists
     * @param name {string} - the long name
     * @return true when found
     **/
    func has(name: string) -> bool {
        // Look the name up
        return self.find(name) >= 0
    }

    /**
     * checkNewE
     * Checks a long name and a shorthand can be declared in this set, the shape of each and that neither is taken already
     * @param name {string} - the long name
     * @param short {string} - the shorthand or ""
     * @return a clean error, or the reason the pair cannot be declared
     **/
    func checkNewE(name: string, short: string) -> error {
        // A name the parser could never reach is refused
        shape: error = flagNameShapeErr(name, short)
        if shape.exists() {
            return shape
        }

        // A duplicate long name is refused
        if self.find(name) >= 0 {
            return error { message: textCat3("flag '--", name, "' already defined") }
        }

        // No shorthand means nothing more to check
        if short == "" {
            return error {}
        }

        // The index of a flag already using the shorthand or -1
        j: int64 = self.findShort(short)

        // A duplicate shorthand is refused
        if j >= 0 {
            other: *Flag = self.get(j)
            head: string = textCat3("shorthand '-", short, "' already used for flag '--")
            msg: string = textCat3(head, (*other).name, "'")
            free(head)
            return error { message: msg }
        }

        // The pair is free
        return error {}
    }

    /**
     * checkNew
     * Aborts on a duplicate long name, a duplicate shorthand or a name or shorthand the parser could never reach, the aborting form of checkNewE
     * @param name {string} - the long name
     * @param short {string} - the shorthand or ""
     * @return nothing
     **/
    func checkNew(name: string, short: string) -> void {
        // Abort with whatever checkNewE refused
        e: error = self.checkNewE(name, short)
        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

    /**
     * tryAddBool
     * Declares a bool flag, or hands back why it cannot be declared and leaves the set alone
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {bool} - the default
     * @param help {string} - the help text
     * @return a clean error, or the reason the flag was refused
     **/
    func tryAddBool(name: string, short: string, def: bool, help: string) -> error {
        // Check the names are free
        e: error = self.checkNewE(name, short)
        if e.exists() {
            return e
        }

        // Push the new flag
        vec_push(self.items, flagMake(name, short, FlagKind.KBool, help, def, "", 0, 0.0))
        return error {}
    }

    /**
     * tryAddStr
     * Declares a string flag, or hands back why it cannot be declared and leaves the set alone
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default
     * @param help {string} - the help text
     * @return a clean error, or the reason the flag was refused
     **/
    func tryAddStr(name: string, short: string, def: string, help: string) -> error {
        // Check the names are free
        e: error = self.checkNewE(name, short)
        if e.exists() {
            return e
        }

        // Push the new flag
        vec_push(self.items, flagMake(name, short, FlagKind.KStr, help, false, def, 0, 0.0))
        return error {}
    }

    /**
     * tryAddInt
     * Declares an int flag, or hands back why it cannot be declared and leaves the set alone
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {int64} - the default
     * @param help {string} - the help text
     * @return a clean error, or the reason the flag was refused
     **/
    func tryAddInt(name: string, short: string, def: int64, help: string) -> error {
        // Check the names are free
        e: error = self.checkNewE(name, short)
        if e.exists() {
            return e
        }

        // Push the new flag
        vec_push(self.items, flagMake(name, short, FlagKind.KInt, help, false, "", def, 0.0))
        return error {}
    }

    /**
     * tryAddFloat
     * Declares a float flag, or hands back why it cannot be declared and leaves the set alone
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {float64} - the default
     * @param help {string} - the help text
     * @return a clean error, or the reason the flag was refused
     **/
    func tryAddFloat(name: string, short: string, def: float64, help: string) -> error {
        // Check the names are free
        e: error = self.checkNewE(name, short)
        if e.exists() {
            return e
        }

        // Push the new flag
        vec_push(self.items, flagMake(name, short, FlagKind.KFloat, help, false, "", 0, def))
        return error {}
    }

    /**
     * tryAddStrs
     * Declares a string slice flag whose default is a comma separated list, or hands back why it cannot be declared and leaves the set alone
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default items, comma separated, "" being the empty list
     * @param help {string} - the help text
     * @return a clean error, or the reason the flag was refused
     **/
    func tryAddStrs(name: string, short: string, def: string, help: string) -> error {
        // Check the names are free
        e: error = self.checkNewE(name, short)
        if e.exists() {
            return e
        }

        // The new flag
        f: *Flag = flagMake(name, short, FlagKind.KStrs, help, false, "", 0, 0.0)

        // Split the default into the default list and again into the value list, the two never share a string
        textPushCommas((*f).defV, def)
        textPushCommas((*f).valV, def)

        // Push the new flag
        vec_push(self.items, f)
        return error {}
    }

    /**
     * tryAddCount
     * Declares a count flag that starts at zero, or hands back why it cannot be declared and leaves the set alone
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param help {string} - the help text
     * @return a clean error, or the reason the flag was refused
     **/
    func tryAddCount(name: string, short: string, help: string) -> error {
        // Check the names are free
        e: error = self.checkNewE(name, short)
        if e.exists() {
            return e
        }

        // Push the new flag
        vec_push(self.items, flagMake(name, short, FlagKind.KCount, help, false, "", 0, 0.0))
        return error {}
    }

    /**
     * tryAddChoice
     * Declares a choice flag whose default must be one of a comma separated list, or hands back why it cannot be declared and leaves the set alone
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default, one of the choices
     * @param choices {string} - the alternatives, comma separated
     * @param help {string} - the help text
     * @return a clean error, or the reason the flag was refused
     **/
    func tryAddChoice(name: string, short: string, def: string, choices: string, help: string) -> error {
        // Check the names are free
        e: error = self.checkNewE(name, short)
        if e.exists() {
            return e
        }

        // The new flag with the alternatives split into its choice list
        f: *Flag = flagMake(name, short, FlagKind.KChoice, help, false, def, 0, 0.0)
        textPushCommas((*f).choices, choices)

        // A default outside the alternatives is refused and the flag thrown away
        if !vec_contains((*f).choices, def) {
            flagFreeLists(f)
            free(f)
            return error { message: textCat3("default for flag '--", name, "' is not one of its choices") }
        }

        // Push the new flag
        vec_push(self.items, f)
        return error {}
    }

    /**
     * addBool
     * Declares a bool flag, aborts where tryAddBool would hand back an error
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {bool} - the default
     * @param help {string} - the help text
     * @return nothing
     **/
    func addBool(name: string, short: string, def: bool, help: string) -> void {
        // Declare it and abort on a refusal
        e: error = self.tryAddBool(name, short, def, help)
        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

