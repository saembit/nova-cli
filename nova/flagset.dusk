     * getCount
     * Gives how many times the count flag name was named, aborts unless such a count flag exists
     * @param name {string} - the long name
     * @return the count
     **/
    func getCount(name: string) -> int64 {
        // The count, aborting on a refusal
        v, e := self.tryGetCount(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * changed
     * Checks if name was set on the command line, aborts when not declared
     * @param name {string} - the long name
     * @return true when set
     **/
    func changed(name: string) -> bool {
        // The answer, aborting on a refusal
        v, e := self.tryChanged(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * setValue
     * Parses raw per the kind of flag i, stores it and marks the flag set from the command line, raw is borrowed and a string kind keeps a copy of it
     * @param i {int64} - the flag index
     * @param raw {string} - the text from the command line
     * @return a clean error, or the Cobra style invalid argument message
     **/
    func setValue(i: int64, raw: string) -> error {
        // The flag
        f: *Flag = self.get(i)

        // Parse and store the text, a repeated string slice adding to what the line already gave it
        e: error = flagStore(f, raw, false)

        // A value the kind refuses leaves the flag as it was
        if e.exists() {
            return e
        }

        // Mark the flag as set on the line
        (*f).changed = true
        (*f).source = FlagSource.SLine

        // Return a clean error
        return error {}
    }

    /**
     * setBoolOn
     * Sets a bare bool flag seen on the command line to true and marks it changed
     * @param i {int64} - the flag index
     * @return nothing
     **/
    func setBoolOn(i: int64) -> void {
        // The flag
        f: *Flag = self.get(i)

        // Set the value, the changed bit and where it came from
        (*f).valB = true
        (*f).changed = true
        (*f).source = FlagSource.SLine
    }

    /**
     * bump
     * Adds one to the count of flag i and marks it changed, what a bare count flag on the command line does
     * @param i {int64} - the flag index
     * @return nothing
     **/
    func bump(i: int64) -> void {
        // The flag
        f: *Flag = self.get(i)

        // Raise the count, set the changed bit and record where it came from
        (*f).valI = (*f).valI + 1
        (*f).changed = true
        (*f).source = FlagSource.SLine
    }

    /**
     * reset
     * Restores every flag to its default, clears changed and puts the source back to SDefault
     * @return nothing
     **/
    func reset() -> void {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop over the flags in the set
        mut i: int64 = 0
        while i < vec_len(items) {
            // The current flag
            f: *Flag = vec_get(items, i)

            // Drop the copy an env or config value left behind
            flagDropHeld(f)

            // Copy the defaults back over the values
            (*f).valB = (*f).defB
            (*f).valS = (*f).defS
            (*f).valI = (*f).defI
            (*f).valF = (*f).defF

            // Rebuild the value list out of fresh copies of the default list
            textFreeStrings((*f).valV)
            textCopyStrings((*f).valV, (*f).defV)

            // Clear the changed bit and go back to holding the default
            (*f).changed = false
            (*f).source = FlagSource.SDefault
            i = i + 1
        }
    }

    /**
     * freeAll
     * Frees every Flag in the set along with the string lists it owns and the item vector, the set struct itself is left for the owner to free
     * @return nothing
     **/
    func freeAll() -> void {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop taking flags off the back
        while vec_len(items) > 0 {
            // The last flag, now owned here
            f: *Flag = vec_take(items, vec_len(items) - 1)

            // Free the string lists it owns then the flag
            flagFreeLists(f)
            free(f)
        }

        // Free the vector buffer and the vector
        vec_free(items)
        free(self.items)

        // Free the empty list a failed tryGetStrs hands back
        vec_free(self.none)
        free(self.none)
    }
}
