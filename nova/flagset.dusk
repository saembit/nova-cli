        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

    /**
     * addChoice
     * Declares a choice flag, a string flag whose value must be one of a comma separated list, the default itself must be one of them, aborts where tryAddChoice would hand back an error
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default, one of the choices
     * @param choices {string} - the alternatives, comma separated
     * @param help {string} - the help text
     * @return nothing
     **/
    func addChoice(name: string, short: string, def: string, choices: string, help: string) -> void {
        // Declare it and abort on a refusal
        e: error = self.tryAddChoice(name, short, def, choices, help)
        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

    /**
     * findE
     * Finds the index of the flag named name, or the error that names it as missing
     * @param name {string} - the long name
     * @return the index and a clean error, or -1 and "no flag named '--name'"
     **/
    func findE(name: string) -> (int64, error) {
        // The index of the flag or -1
        i: int64 = self.find(name)

        // A missing flag is the error
        if i < 0 {
            return (-1, error { message: textCat3("no flag named '--", name, "'") })
        }
        return (i, error {})
    }

    /**
     * findKindE
     * Finds the index of the flag named name when it is declared with kind kind, the lookup every typed try getter runs
     * @param name {string} - the long name
     * @param kind {FlagKind} - the kind it must have
     * @param word {string} - the kind word used in the message
     * @return the index and a clean error, or -1 and "no <word> flag named '--name'"
     **/
    func findKindE(name: string, kind: FlagKind, word: string) -> (int64, error) {
        // The index of the flag or -1
        i: int64 = self.find(name)

        // A missing flag or one of another kind is the same error
        if i < 0 || !flagKindEq((*self.get(i)).kind, kind) {
            head: string = textCat3("no ", word, " flag named '--")
            msg: string = textCat3(head, name, "'")
            free(head)
            return (-1, error { message: msg })
        }
        return (i, error {})
    }

    /**
     * findStrLikeE
     * Finds the index of the flag named name when it is declared as a string or as a choice, the two kinds tryGetStr reads
     * @param name {string} - the long name
     * @return the index and a clean error, or -1 and "no string flag named '--name'"
     **/
    func findStrLikeE(name: string) -> (int64, error) {
        // The index of the flag or -1
        i: int64 = self.find(name)

        // Either kind that carries a string will do
        if i >= 0 {
            k: FlagKind = (*self.get(i)).kind
            if flagKindEq(k, FlagKind.KStr) || flagKindEq(k, FlagKind.KChoice) {
                return (i, error {})
            }
        }

        // Anything else is the error
        return (-1, error { message: textCat3("no string flag named '--", name, "'") })
    }

    /**
     * require
     * Gives the flag named name, aborts when it is not declared
     * @param name {string} - the long name
     * @return the flag
     **/
    func require(name: string) -> *Flag {
        // The index of the flag, aborting when there is none
        i, e := self.findE(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }

        // Return the flag
        return self.get(i)
    }

    /**
     * requireKind
     * Gives the flag named name, aborts unless it is declared with kind kind
     * @param name {string} - the long name
     * @param kind {FlagKind} - the kind it must have
     * @param word {string} - the kind word used in the fault message
     * @return the flag
     **/
    func requireKind(name: string, kind: FlagKind, word: string) -> *Flag {
        // The index of the flag, aborting when there is none of that kind
        i, e := self.findKindE(name, kind, word)
        if e.exists() {
            novaFaultMsg(e.message)
        }

        // Return the flag
        return self.get(i)
    }

    /**
     * requireStrLike
     * Gives the flag named name, aborts unless it is declared as a string or as a choice, the two kinds getStr reads
     * @param name {string} - the long name
     * @return the flag
     **/
    func requireStrLike(name: string) -> *Flag {
        // The index of the flag, aborting when it carries no string
        i, e := self.findStrLikeE(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }

        // Return the flag
        return self.get(i)
    }

    /**
     * tryMarkRequired
     * Marks name as required, the executor errors when it is not set
     * @param name {string} - the long name
     * @return a clean error, or "no flag named '--name'"
     **/
    func tryMarkRequired(name: string) -> error {
        // The flag, or the error naming it as missing
        i, e := self.findE(name)
        if e.exists() {
            return e
        }

        // Set the required bit
        (*self.get(i)).required = true
        return error {}
    }

    /**
     * tryMarkHidden
     * Hides name from help output
     * @param name {string} - the long name
     * @return a clean error, or "no flag named '--name'"
     **/
    func tryMarkHidden(name: string) -> error {
        // The flag, or the error naming it as missing
        i, e := self.findE(name)
        if e.exists() {
            return e
        }

        // Set the hidden bit
        (*self.get(i)).hidden = true
        return error {}
    }

    /**
     * tryMarkDeprecated
     * Marks name deprecated with a message shown when it is used, the flag is hidden from help
     * @param name {string} - the long name
     * @param msg {string} - the message
     * @return a clean error, or "no flag named '--name'"
     **/
    func tryMarkDeprecated(name: string, msg: string) -> error {
        // The flag, or the error naming it as missing
        i, e := self.findE(name)
        if e.exists() {
            return e
        }

        // Store the message
        (*self.get(i)).deprecated = msg
        return error {}
    }

    /**
     * tryBindEnv
     * Binds name to one environment variable by its exact spelling, a set cannot see the root it ends up under so a binding in a strict tree is reported by novaValidate and refused by novaExecuteE rather than here
     * @param name {string} - the long name
     * @param varName {string} - the environment variable, borrowed
     * @return a clean error, or "no flag named '--name'"
     **/
    func tryBindEnv(name: string, varName: string) -> error {
        // The flag, or the error naming it as missing
        i, e := self.findE(name)
        if e.exists() {
            return e
        }

        // Store the variable name
        (*self.get(i)).env = varName
        return error {}
    }

    /**
     * markRequired
     * Marks name as required, the executor errors when it is not set, aborts when it is not declared
     * @param name {string} - the long name
     * @return nothing
     **/
    func markRequired(name: string) -> void {
        // Mark it and abort on a refusal
        e: error = self.tryMarkRequired(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

    /**
     * markHidden
     * Hides name from help output, aborts when it is not declared
     * @param name {string} - the long name
     * @return nothing
     **/
    func markHidden(name: string) -> void {
        // Mark it and abort on a refusal
        e: error = self.tryMarkHidden(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

    /**
     * markDeprecated
     * Marks name deprecated with a message shown when it is used, the flag is hidden from help, aborts when it is not declared
     * @param name {string} - the long name
     * @param msg {string} - the message
     * @return nothing
     **/
    func markDeprecated(name: string, msg: string) -> void {
        // Mark it and abort on a refusal
