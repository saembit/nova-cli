        }
    }

    /**
     * addStrs
     * Declares a string slice flag whose default is written as a comma separated list, "" being the empty list, aborts where tryAddStrs would hand back an error
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default items, comma separated
     * @param help {string} - the help text
     * @return nothing
     **/
    func addStrs(name: string, short: string, def: string, help: string) -> void {
        // Declare it and abort on a refusal
        e: error = self.tryAddStrs(name, short, def, help)
        if e.exists() {
            novaFaultMsg(e.message)
        }
    }

    /**
     * addCount
     * Declares a count flag, one that counts how many times it was named and starts at zero, aborts where tryAddCount would hand back an error
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param help {string} - the help text
     * @return nothing
     **/
    func addCount(name: string, short: string, help: string) -> void {
