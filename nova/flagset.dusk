/**
 * nova/flagset.dusk
 * The flags a command declares, a FlagSet is a registry of bool, string, int, float, string slice, count and choice flags with optional one character shorthands, looked up by long name or shorthand and set from raw command line text one token at a time by the executor
 * Bad input is an error value the executor reports, misuse of the library such as a duplicate flag, a getter on the wrong kind, etc. aborts with "fatal: nova: ..." on stderr
 **/
@paradigm oop
@paradigm procedural

@import std.string
@import std.vector
@import text

/**
 * FlagKind
 * The value shapes a flag can carry
 **/
export enum FlagKind { KBool, KStr, KInt, KFloat, KStrs, KCount, KChoice }

/**
 * Flag
 * One declared flag, only the def and val pair matching kind is meaningful and the others hold zero values, the plain strings are borrowed from the caller's literals or argv and never freed here while every string inside defV, valV and choices is a fresh heap copy the flag owns
 **/
export struct Flag {
    name: string,
    short: string,
    kind: FlagKind,
    help: string,
    defB: bool,
    defS: string,
    defI: int64,
    defF: float64,
    valB: bool,
    valS: string,
    valI: int64,
    valF: float64,
    defV: *Vector<string>,
    valV: *Vector<string>,
    choices: *Vector<string>,
    changed: bool,
    required: bool,
    hidden: bool,
    deprecated: string,
}

/**
 * FlagSet
 * A set of flags in declaration order, build with flagsetNew() and pass by pointer, freeAll frees the flags and the item vector and the owner frees the set itself, novaFreeTree does both for every set in a tree
 **/
export struct FlagSet {
    items: *Vector<*Flag>,
}

/**
 * flagsetNew
 * Makes a fresh empty heap FlagSet
 * @return a pointer to the new set
 **/
export func flagsetNew() -> *FlagSet {
    // The empty item vector
    v: *Vector<*Flag> = alloc(vec_new())

    // Return the new set
    return alloc(FlagSet { items: v })
}

/**
 * flagKindWord
 * Gives the type word help prints after a flag name, "" for the kinds that take no value and a static word for the rest, a choice has no word of its own since it prints its own alternatives
 * @param k {FlagKind} - the kind
 * @return a static literal
 **/
export func flagKindWord(k: FlagKind) -> string {
    // Pick the word by kind
    match k {
        KBool => return "",
        KStr => return "string",
        KInt => return "int",
        KFloat => return "float",
        KStrs => return "strings",
        KCount => return "",
        KChoice => return "",
    }
}

// The position of a kind in the enum, the number two kinds are compared by
func flagKindIndex(k: FlagKind) -> int64 {
    // Pick the position by kind
    match k {
        KBool => return 0,
        KStr => return 1,
        KInt => return 2,
        KFloat => return 3,
        KStrs => return 4,
        KCount => return 5,
        KChoice => return 6,
    }
}

/**
 * flagKindEq
 * Checks if two kinds are the same variant since enums do not compare with ==
 * @param a {FlagKind} - the first kind
 * @param b {FlagKind} - the second kind
 * @return true when they match
 **/
export func flagKindEq(a: FlagKind, b: FlagKind) -> bool {
    // Compare the two positions
    return flagKindIndex(a) == flagKindIndex(b)
}

/**
 * flagTakesValue
 * Checks if a flag consumes a value token, every kind but bool and count does
 * @param f {*Flag} - the flag, borrowed
 * @return true when the flag wants a value
 **/
export func flagTakesValue(f: *Flag) -> bool {
    // A bool is set by being there
    if flagKindEq((*f).kind, FlagKind.KBool) {
        return false
    }

    // A count is counted by being there
    if flagKindEq((*f).kind, FlagKind.KCount) {
        return false
    }

    // Everything else wants a value
    return true
}

/**
 * flagTypeWord
 * Gives the type word help prints after a flag name, the kind word for most flags and the alternatives joined with "|" for a choice
 * @param f {*Flag} - the flag, borrowed
 * @return a fresh heap string, empty for the kinds with no word
 **/
export func flagTypeWord(f: *Flag) -> string {
    // A choice prints its own alternatives
    if flagKindEq((*f).kind, FlagKind.KChoice) {
        // The alternatives in declaration order
        ch: *Vector<string> = (*f).choices

        // Join them with bars
        return str_join(ch, "|")
    }

    // The static word of the kind
    w: string = flagKindWord((*f).kind)

    // Return a copy of it so every caller frees the same way
    return substring(w, 0, str_len(w))
}

/**
 * flagParseBool
 * Parses a boolean word the way "--flag=value" accepts it, true/false, 1/0, t/f, yes/no, y/n, case insensitive
 * @param raw {string} - the text, borrowed
 * @return the value and an error, the error message is "expected a boolean" on bad text
 **/
export func flagParseBool(raw: string) -> (bool, error) {
    // The lower cased text
    low: string = to_lower(raw)

    // Whether the text matched and the value it gave
    mut ok: bool = false
    mut val: bool = false

    // Check the true words then the false words
    if low == "true" || low == "1" || low == "t" || low == "yes" || low == "y" {
        ok = true
        val = true
    } else if low == "false" || low == "0" || low == "f" || low == "no" || low == "n" {
        ok = true
        val = false
    }

    // Free the lower cased copy
    free(low)

    // Return the value on a match
    if ok {
        return (val, error {})
    }

    // Return the error for bad text
    return (false, error { message: "expected a boolean" })
}

/**
 * flagInvalidArg
 * Builds the Cobra style invalid argument "raw" for "--name" flag: <why> error
 * @param raw {string} - the bad text
 * @param name {string} - the long flag name
 * @param why {string} - the reason
 * @return the error holding the message
 **/
func flagInvalidArg(raw: string, name: string, why: string) -> error {
    // The quoted raw text
    q: string = textQuote(raw)

    // The full message
    msg: string = "invalid argument " + q + " for \"--" + name + "\" flag: " + why

    // Free the quoted copy
    free(q)

    // Return the error with the message
    return error { message: msg }
}

/**
 * flagMake
 * Makes a fresh heap Flag of the given kind with its value set to its default
 * @param name {string} - the long name
 * @param short {string} - the shorthand or ""
 * @param kind {FlagKind} - the kind
 * @param help {string} - the help text
 * @param defB {bool} - the bool default
 * @param defS {string} - the string default
 * @param defI {int64} - the int default
 * @param defF {float64} - the float default
 * @return a pointer to the new flag
 **/
func flagMake(name: string, short: string, kind: FlagKind, help: string, defB: bool, defS: string, defI: int64, defF: float64) -> *Flag {
    // The default list, the value list and the choice list, empty until a kind that uses them fills them
    dv: *Vector<string> = alloc(vec_new())
    vv: *Vector<string> = alloc(vec_new())
    ch: *Vector<string> = alloc(vec_new())

    // Return the new flag with the value equal to the default
    return alloc(Flag {
        name: name, short: short, kind: kind, help: help,
        defB: defB, defS: defS, defI: defI, defF: defF,
        valB: defB, valS: defS, valI: defI, valF: defF,
        defV: dv, valV: vv, choices: ch,
        changed: false, required: false, hidden: false, deprecated: "",
    })
}

// Frees the three string lists a flag owns along with their vectors
func flagFreeLists(f: *Flag) -> void {
    // The default list
    dv: *Vector<string> = (*f).defV
    textFreeStrings(dv)
    vec_free(dv)
    free((*f).defV)

    // The value list
    vv: *Vector<string> = (*f).valV
    textFreeStrings(vv)
    vec_free(vv)
    free((*f).valV)

    // The choice list
    ch: *Vector<string> = (*f).choices
    textFreeStrings(ch)
    vec_free(ch)
    free((*f).choices)
}

impl FlagSet {
    /**
     * len
     * Gives the number of flags declared
     * @return the count
     **/
    func len() -> int64 {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Return the length
        return vec_len(items)
    }

    /**
     * get
     * Gives the flag at index i, aborts when out of range
     * @param i {int64} - the index
     * @return the flag
     **/
    func get(i: int64) -> *Flag {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Return the flag at i
        return vec_get(items, i)
    }

    /**
     * find
     * Finds the index of the flag with long name name
     * @param name {string} - the long name
     * @return the index or -1
     **/
    func find(name: string) -> int64 {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop over the flags in the set
        mut i: int64 = 0
        while i < vec_len(items) {
            // The current flag
            f: *Flag = vec_get(items, i)

            // Return the index on a name match
            if (*f).name == name {
                return i
            }
            i = i + 1
        }

        // Not found
        return -1
    }

    /**
     * findShort
     * Finds the index of the flag with shorthand short, "" never matches
     * @param short {string} - the shorthand
     * @return the index or -1
     **/
    func findShort(short: string) -> int64 {
        // An empty shorthand matches nothing
        if short == "" {
            return -1
        }

        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop over the flags in the set
        mut i: int64 = 0
        while i < vec_len(items) {
            // The current flag
            f: *Flag = vec_get(items, i)

            // Return the index on a shorthand match
            if (*f).short == short {
                return i
            }
            i = i + 1
        }

        // Not found
        return -1
    }

    /**
     * has
     * Checks if a flag with long name name exists
     * @param name {string} - the long name
     * @return true when found
     **/
    func has(name: string) -> bool {
        // Look the name up
        return self.find(name) >= 0
    }

    /**
     * checkNew
     * Aborts on a duplicate long name, a duplicate shorthand or a shorthand longer than one character
     * @param name {string} - the long name
     * @param short {string} - the shorthand or ""
     * @return nothing
     **/
    func checkNew(name: string, short: string) -> void {
        // A duplicate long name is a fault
        if self.find(name) >= 0 {
            novaFault("flag '--", name, "' already defined")
        }

        // Check the shorthand when there is one
        if short != "" {
            // The shorthand must be one character
            if !textIsOneChar(short) {
                novaFault("shorthand for flag '--", name, "' must be one character")
            }

            // The index of a flag already using the shorthand or -1
            j: int64 = self.findShort(short)

            // A duplicate shorthand is a fault
            if j >= 0 {
                other: *Flag = self.get(j)
                novaFault("shorthand '-" + short + "' already used for flag '--", (*other).name, "'")
            }
        }
    }

    /**
     * addBool
     * Declares a bool flag
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {bool} - the default
     * @param help {string} - the help text
     * @return nothing
     **/
    func addBool(name: string, short: string, def: bool, help: string) -> void {
        // Check the names are free
        self.checkNew(name, short)

        // The item vector
        items: *Vector<*Flag> = self.items

        // Push the new flag
        vec_push(items, flagMake(name, short, FlagKind.KBool, help, def, "", 0, 0.0))
    }

    /**
     * addStr
     * Declares a string flag
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default
     * @param help {string} - the help text
     * @return nothing
     **/
    func addStr(name: string, short: string, def: string, help: string) -> void {
        // Check the names are free
        self.checkNew(name, short)

        // The item vector
        items: *Vector<*Flag> = self.items

        // Push the new flag
        vec_push(items, flagMake(name, short, FlagKind.KStr, help, false, def, 0, 0.0))
    }

    /**
     * addInt
     * Declares an int flag
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {int64} - the default
     * @param help {string} - the help text
     * @return nothing
     **/
    func addInt(name: string, short: string, def: int64, help: string) -> void {
        // Check the names are free
        self.checkNew(name, short)

        // The item vector
        items: *Vector<*Flag> = self.items

        // Push the new flag
        vec_push(items, flagMake(name, short, FlagKind.KInt, help, false, "", def, 0.0))
    }

    /**
     * addFloat
     * Declares a float flag
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {float64} - the default
     * @param help {string} - the help text
     * @return nothing
     **/
    func addFloat(name: string, short: string, def: float64, help: string) -> void {
        // Check the names are free
        self.checkNew(name, short)

        // The item vector
        items: *Vector<*Flag> = self.items

        // Push the new flag
        vec_push(items, flagMake(name, short, FlagKind.KFloat, help, false, "", 0, def))
    }

    /**
     * addStrs
     * Declares a string slice flag whose default is written as a comma separated list, "" being the empty list
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default items, comma separated
     * @param help {string} - the help text
     * @return nothing
     **/
    func addStrs(name: string, short: string, def: string, help: string) -> void {
        // Check the names are free
        self.checkNew(name, short)

        // The item vector
        items: *Vector<*Flag> = self.items

        // The new flag
        f: *Flag = flagMake(name, short, FlagKind.KStrs, help, false, "", 0, 0.0)

        // Split the default into the default list and again into the value list, the two never share a string
        textPushCommas((*f).defV, def)
        textPushCommas((*f).valV, def)

        // Push the new flag
        vec_push(items, f)
    }

    /**
     * addCount
     * Declares a count flag, one that counts how many times it was named and starts at zero
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param help {string} - the help text
     * @return nothing
     **/
    func addCount(name: string, short: string, help: string) -> void {
        // Check the names are free
        self.checkNew(name, short)

        // The item vector
        items: *Vector<*Flag> = self.items

        // Push the new flag
        vec_push(items, flagMake(name, short, FlagKind.KCount, help, false, "", 0, 0.0))
    }

    /**
     * addChoice
     * Declares a choice flag, a string flag whose value must be one of a comma separated list, the default itself must be one of them
     * @param name {string} - the long name
     * @param short {string} - one character or ""
     * @param def {string} - the default, one of the choices
     * @param choices {string} - the alternatives, comma separated
     * @param help {string} - the help text
     * @return nothing
     **/
    func addChoice(name: string, short: string, def: string, choices: string, help: string) -> void {
        // Check the names are free
        self.checkNew(name, short)

        // The item vector
        items: *Vector<*Flag> = self.items

        // The new flag
        f: *Flag = flagMake(name, short, FlagKind.KChoice, help, false, def, 0, 0.0)

        // Split the alternatives into the choice list
        textPushCommas((*f).choices, choices)

        // A default outside the alternatives is a fault
        if !vec_contains((*f).choices, def) {
            novaFault("default for flag '--", name, "' is not one of its choices")
        }

        // Push the new flag
        vec_push(items, f)
    }

    /**
     * require
     * Gives the flag named name, aborts when it is not declared
     * @param name {string} - the long name
     * @return the flag
     **/
    func require(name: string) -> *Flag {
        // The index of the flag or -1
        i: int64 = self.find(name)

        // A missing flag is a fault
        if i < 0 {
            novaFault("no flag named '--", name, "'")
        }

        // Return the flag
        return self.get(i)
    }

    /**
     * requireKind
     * Gives the flag named name, aborts unless it is declared with kind kind
     * @param name {string} - the long name
     * @param kind {FlagKind} - the kind it must have
     * @param word {string} - the kind word used in the fault message
     * @return the flag
     **/
    func requireKind(name: string, kind: FlagKind, word: string) -> *Flag {
        // The index of the flag or -1
        i: int64 = self.find(name)

        // A missing flag is a fault
        if i < 0 {
            novaFault("no " + word + " flag named '--", name, "'")
        }

        // The flag
        f: *Flag = self.get(i)

        // The wrong kind is the same fault
        if !flagKindEq((*f).kind, kind) {
            novaFault("no " + word + " flag named '--", name, "'")
        }

        // Return the flag
        return f
    }

    /**
     * requireStrLike
     * Gives the flag named name, aborts unless it is declared as a string or as a choice, the two kinds getStr reads
     * @param name {string} - the long name
     * @return the flag
     **/
    func requireStrLike(name: string) -> *Flag {
        // The index of the flag or -1
        i: int64 = self.find(name)

        // A missing flag is a fault
        if i < 0 {
            novaFault("no string flag named '--", name, "'")
        }

        // The flag
        f: *Flag = self.get(i)

        // A kind that carries no string is the same fault
        if !flagKindEq((*f).kind, FlagKind.KStr) && !flagKindEq((*f).kind, FlagKind.KChoice) {
            novaFault("no string flag named '--", name, "'")
        }

        // Return the flag
        return f
    }

    /**
     * markRequired
     * Marks name as required, the executor errors when it is not set
     * @param name {string} - the long name
     * @return nothing
     **/
    func markRequired(name: string) -> void {
        // The flag
        f: *Flag = self.require(name)

        // Set the required bit
        (*f).required = true
    }

    /**
     * markHidden
     * Hides name from help output
     * @param name {string} - the long name
     * @return nothing
     **/
    func markHidden(name: string) -> void {
        // The flag
        f: *Flag = self.require(name)

        // Set the hidden bit
        (*f).hidden = true
    }

    /**
     * markDeprecated
     * Marks name deprecated with a message shown when it is used, the flag is hidden from help
     * @param name {string} - the long name
     * @param msg {string} - the message
     * @return nothing
     **/
    func markDeprecated(name: string, msg: string) -> void {
        // The flag
        f: *Flag = self.require(name)

        // Store the message
        (*f).deprecated = msg
    }

    /**
     * getBool
     * Gives the value of the bool flag name, aborts unless such a bool flag exists
     * @param name {string} - the long name
     * @return the value
     **/
    func getBool(name: string) -> bool {
        // The flag checked for kind
        f: *Flag = self.requireKind(name, FlagKind.KBool, "bool")

        // Return the bool value
        return (*f).valB
    }

    /**
     * getStr
     * Gives the value of the string flag name, aborts unless such a string flag exists
     * @param name {string} - the long name
     * @return the value
     **/
    func getStr(name: string) -> string {
        // The flag checked for kind, a string or a choice
        f: *Flag = self.requireStrLike(name)

        // Return the string value
        return (*f).valS
    }

    /**
     * getInt
     * Gives the value of the int flag name, aborts unless such an int flag exists
     * @param name {string} - the long name
     * @return the value
     **/
    func getInt(name: string) -> int64 {
        // The flag checked for kind
        f: *Flag = self.requireKind(name, FlagKind.KInt, "int")

        // Return the int value
        return (*f).valI
    }

    /**
     * getFloat
     * Gives the value of the float flag name, aborts unless such a float flag exists
     * @param name {string} - the long name
     * @return the value
     **/
    func getFloat(name: string) -> float64 {
        // The flag checked for kind
        f: *Flag = self.requireKind(name, FlagKind.KFloat, "float")

        // Return the float value
        return (*f).valF
    }

    /**
     * getStrs
     * Gives the value of the string slice flag name, aborts unless such a flag exists
     * @param name {string} - the long name
     * @return the items, borrowed from the flag and never freed by the caller
     **/
    func getStrs(name: string) -> *Vector<string> {
        // The flag checked for kind
        f: *Flag = self.requireKind(name, FlagKind.KStrs, "strings")

        // Return the value list
        return (*f).valV
    }

    /**
     * getCount
     * Gives how many times the count flag name was named, aborts unless such a count flag exists
     * @param name {string} - the long name
     * @return the count
     **/
    func getCount(name: string) -> int64 {
        // The flag checked for kind
        f: *Flag = self.requireKind(name, FlagKind.KCount, "count")

        // Return the count
        return (*f).valI
    }

    /**
     * changed
     * Checks if name was set on the command line, aborts when not declared
     * @param name {string} - the long name
     * @return true when set
     **/
    func changed(name: string) -> bool {
        // The flag
        f: *Flag = self.require(name)

        // Return the changed bit
        return (*f).changed
    }

    /**
     * setValue
     * Parses raw per the kind of flag i, stores it and marks the flag changed, raw is borrowed and kept as the string value
     * @param i {int64} - the flag index
     * @param raw {string} - the text from the command line
     * @return a clean error, or the Cobra style invalid argument message
     **/
    func setValue(i: int64, raw: string) -> error {
        // The flag
        f: *Flag = self.get(i)

        // Parse and store by kind
        match (*f).kind {
            KBool => {
                // Parse the bool word
                b, e := flagParseBool(raw)
                if e.exists() {
                    return flagInvalidArg(raw, (*f).name, "expected a boolean")
                }
                (*f).valB = b
            },
            KStr => {
                // Keep the raw text as the value
                (*f).valS = raw
            },
            KInt => {
                // Parse the int
                n, e := parse_int(raw)
                if e.exists() {
                    return flagInvalidArg(raw, (*f).name, "expected an integer")
                }
                (*f).valI = n
            },
            KFloat => {
                // Parse the number
                x, e := parse_float(raw)
                if e.exists() {
                    return flagInvalidArg(raw, (*f).name, "expected a number")
                }
                (*f).valF = x
            },
            KStrs => {
                // The first occurrence on the line drops the default, every later one appends
                if !(*f).changed {
                    textFreeStrings((*f).valV)
                }

                // Split the text on commas onto the end of the value list
                textPushCommas((*f).valV, raw)
            },
            KCount => {
                // Parse the count the "=N" form carries
                n, e := parse_int(raw)
                if e.exists() {
                    return flagInvalidArg(raw, (*f).name, "expected an integer")
                }
                (*f).valI = n
            },
            KChoice => {
                // The alternatives this flag was declared with
                ch: *Vector<string> = (*f).choices

                // A value outside them is the invalid argument error
                if !vec_contains(ch, raw) {
                    // The alternatives quoted and joined the way the message lists them
                    joined: string = textJoinQuoted(ch, ", ")

                    // The reason and the error built around it
                    why: string = "must be one of " + joined
                    e2: error = flagInvalidArg(raw, (*f).name, why)

                    // Free the two built strings
                    free(why)
                    free(joined)
                    return e2
                }

                // Keep the raw text as the value
                (*f).valS = raw
            },
        }

        // Mark the flag as set
        (*f).changed = true

        // Return a clean error
        return error {}
    }

    /**
     * setBoolOn
     * Sets a bare bool flag seen on the command line to true and marks it changed
     * @param i {int64} - the flag index
     * @return nothing
     **/
    func setBoolOn(i: int64) -> void {
        // The flag
        f: *Flag = self.get(i)

        // Set the value and the changed bit
        (*f).valB = true
        (*f).changed = true
    }

    /**
     * bump
     * Adds one to the count of flag i and marks it changed, what a bare count flag on the command line does
     * @param i {int64} - the flag index
     * @return nothing
     **/
    func bump(i: int64) -> void {
        // The flag
        f: *Flag = self.get(i)

        // Raise the count and set the changed bit
        (*f).valI = (*f).valI + 1
        (*f).changed = true
    }

    /**
     * reset
     * Restores every flag to its default and clears changed
     * @return nothing
     **/
    func reset() -> void {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop over the flags in the set
        mut i: int64 = 0
        while i < vec_len(items) {
            // The current flag
            f: *Flag = vec_get(items, i)

            // Copy the defaults back over the values
            (*f).valB = (*f).defB
            (*f).valS = (*f).defS
            (*f).valI = (*f).defI
            (*f).valF = (*f).defF

            // Rebuild the value list out of fresh copies of the default list
            textFreeStrings((*f).valV)
            textCopyStrings((*f).valV, (*f).defV)

            // Clear the changed bit
            (*f).changed = false
            i = i + 1
        }
    }

    /**
     * freeAll
     * Frees every Flag in the set along with the string lists it owns and the item vector, the set struct itself is left for the owner to free
     * @return nothing
     **/
    func freeAll() -> void {
        // The item vector
        items: *Vector<*Flag> = self.items

        // Loop taking flags off the back
        while vec_len(items) > 0 {
            // The last flag, now owned here
            f: *Flag = vec_take(items, vec_len(items) - 1)

            // Free the string lists it owns then the flag
            flagFreeLists(f)
            free(f)
        }

        // Free the vector buffer and the vector
        vec_free(items)
        free(self.items)
    }
}
