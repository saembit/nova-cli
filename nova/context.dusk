/**
 * nova/context.dusk
 * What a handler receives, a Context names the command that runs, the root, the chain of commands from the root down to it, the positional args left after flag parsing and the raw argv
 * Flag getters resolve a name against the command's local flags, then its persistent flags, then each ancestor's persistent flags nearest first, asking for a flag no command on the chain declares is an error value from the try forms (tryGetStr, tryArg, ...) and aborts with "fatal: nova: ..." from the plain forms built on them
 * changed() answers whether the command line set a flag while source() answers where its value came from at all, the line, the environment, a config file or the declaration
 **/
@paradigm oop
@paradigm procedural

@import std.string
@import std.vector
@import flagset
@import text
@import sink
@import command
@import help

/**
 * Context
 * The handler's view of one invocation, built by novaExecute, borrowed by every hook and freed by novaExecute once the hooks are done, a hook must not keep it
 **/
export struct Context {
    cmd: *Command,
    root: *Command,
    chain: *Vector<*Command>,
    args: *Vector<string>,
    argv: string[],
}

/**
 * ctxFindIn
 * Runs find or findShort on one set by the byShort switch
 * @param fset {*FlagSet} - the set
 * @param key {string} - the long name or the shorthand
 * @param byShort {bool} - true to look up by shorthand
 * @return the index or -1
 **/
func ctxFindIn(fset: *FlagSet, key: string, byShort: bool) -> int64 {
    // Look up by shorthand when asked
    if byShort {
        return fset.findShort(key)
    }

    // Look up by long name
    return fset.find(key)
}

/**
 * ctxLookupAny
 * The shared walk behind ctxLookupChain and ctxLookupShortChain, the leaf's local flags then the persistent flags of every chain entry from the leaf up to the root
 * @param chain {*Vector<*Command>} - the commands root..cmd, borrowed
 * @param key {string} - the long name or the shorthand
 * @param byShort {bool} - true to look up by shorthand
 * @return (set, index, found), when not found the set is the leaf's flags and the index -1
 **/
func ctxLookupAny(chain: *Vector<*Command>, key: string, byShort: bool) -> (*FlagSet, int64, bool) {
    // The chain length
    n: int64 = vec_len(chain)

    // The leaf command
    leaf: *Command = vec_get(chain, n - 1)

    // The leaf's local flags
    localf: *FlagSet = (*leaf).flags

    // Look in the local flags first
    li: int64 = ctxFindIn(localf, key, byShort)
    if li >= 0 {
        return (localf, li, true)
    }

    // Walk the chain from the leaf up to the root
    mut k: int64 = n - 1
    while k >= 0 {
        // The current command
        c: *Command = vec_get(chain, k)

        // Its persistent flags
        pf: *FlagSet = (*c).pflags

        // Return on the first match
        pi: int64 = ctxFindIn(pf, key, byShort)
        if pi >= 0 {
            return (pf, pi, true)
        }
        k = k - 1
    }

    // Not found
    return (localf, -1, false)
}

/**
 * ctxLookupChain
 * Resolves a long flag name against a chain root..cmd, the last command's local flags, then its persistent flags, then each ancestor's persistent flags nearest first, "help" is never stored as a flag so it is never found
 * @param chain {*Vector<*Command>} - the commands root..cmd, borrowed
 * @param name {string} - the long name without dashes
 * @return (set, index, found), when not found the set is cmd.flags and the index -1
 **/
export func ctxLookupChain(chain: *Vector<*Command>, name: string) -> (*FlagSet, int64, bool) {
    // Walk by long name
    return ctxLookupAny(chain, name, false)
}

/**
 * ctxLookupShortChain
 * Resolves a one character shorthand along a chain the way ctxLookupChain resolves a long name, then re-resolves the long name of the flag it found so a flag nearer the leaf under the same long name wins
 * @param chain {*Vector<*Command>} - the commands root..cmd, borrowed
 * @param short {string} - the shorthand, one character
 * @return (set, index, found), when not found the set is cmd.flags and the index -1
 **/
export func ctxLookupShortChain(chain: *Vector<*Command>, short: string) -> (*FlagSet, int64, bool) {
    // Walk by shorthand
    fset, i, found := ctxLookupAny(chain, short, true)

    // Nothing carries the shorthand
    if !found {
        return (fset, i, found)
    }

    // The flag that carries it
    f: *Flag = fset.get(i)

    // Walk again by its long name
    return ctxLookupAny(chain, (*f).name, false)
}

/**
 * ctxLookup
 * Resolves a long flag name for a context, cmd.flags, cmd.pflags, then the ancestors' pflags nearest first
 * @param ctx {*Context} - the context
 * @param name {string} - the long name without dashes
 * @return (set, index, found)
 **/
export func ctxLookup(ctx: *Context, name: string) -> (*FlagSet, int64, bool) {
    // The chain of the context
    chain: *Vector<*Command> = (*ctx).chain

    // Walk the chain
    return ctxLookupChain(chain, name)
}

/**
 * ctxRequireE
 * Gives the set holding name on a chain, or the error naming it as missing
 * @param chain {*Vector<*Command>} - the commands root..cmd, borrowed
 * @param name {string} - the long name without dashes
 * @return the set and a clean error, or the leaf's own set and "no flag named '--name'"
 **/
func ctxRequireE(chain: *Vector<*Command>, name: string) -> (*FlagSet, error) {
    // Walk the chain
    fset, i, found := ctxLookupChain(chain, name)

    // A missing flag is the error
    if !found || i < 0 {
        return (fset, error { message: textCat3("no flag named '--", name, "'") })
    }

    // Return the set
    return (fset, error {})
}

/**
 * ctxArgIndexErr
 * Checks i is a valid index into the positionals
 * @param args {*Vector<string>} - the positionals, borrowed
 * @param i {int64} - the index
 * @return a clean error, or "positional index <i> is out of range, the command got <n>"
 **/
func ctxArgIndexErr(args: *Vector<string>, i: int64) -> error {
    // An index inside the vector is fine
    n: int64 = vec_len(args)
    if i >= 0 && i < n {
        return error {}
    }

    // Anything else names the index and the count
    sb: *StringBuilder = alloc(sb_new())
    sb_push(sb, "positional index ")
    sb_push_int(sb, i)
    sb_push(sb, " is out of range, the command got ")
    sb_push_int(sb, n)
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return error { message: out }
}

impl Context {
    /**
     * nargs
     * Gives the number of positional args
     * @return the count
     **/
    func nargs() -> int64 {
        // The arg vector
        a: *Vector<string> = self.args

        // Return the length
        return vec_len(a)
    }

    /**
     * tryArg
     * Gives the positional arg at index i
     * @param i {int64} - the index
     * @return the arg and a clean error, or "" and the out of range error
     **/
    func tryArg(i: int64) -> (string, error) {
        // The arg vector
        a: *Vector<string> = self.args

        // An index outside the positionals is the error
        e: error = ctxArgIndexErr(a, i)
        if e.exists() {
            return ("", e)
        }

        // Return the arg at i
        return (vec_get(a, i), error {})
    }

    /**
     * tryGetBool
     * Gives the value of the bool flag name as resolved along the chain
     * @param name {string} - the long name
     * @return the value and a clean error, or false and the error naming the flag
     **/
    func tryGetBool(name: string) -> (bool, error) {
        // The set that holds the flag
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return (false, e)
        }

        // Ask the set, which checks the kind
        return fset.tryGetBool(name)
    }

    /**
     * tryGetStr
     * Gives the value of the string or choice flag name as resolved along the chain
     * @param name {string} - the long name
     * @return the value and a clean error, or "" and the error naming the flag
     **/
    func tryGetStr(name: string) -> (string, error) {
        // The set that holds the flag
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return ("", e)
        }

        // Ask the set, which checks the kind
        return fset.tryGetStr(name)
    }

    /**
     * tryGetInt
     * Gives the value of the int flag name as resolved along the chain
     * @param name {string} - the long name
     * @return the value and a clean error, or 0 and the error naming the flag
     **/
    func tryGetInt(name: string) -> (int64, error) {
        // The set that holds the flag
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return (0, e)
        }

        // Ask the set, which checks the kind
        return fset.tryGetInt(name)
    }

    /**
     * tryGetFloat
     * Gives the value of the float flag name as resolved along the chain
     * @param name {string} - the long name
     * @return the value and a clean error, or 0.0 and the error naming the flag
     **/
    func tryGetFloat(name: string) -> (float64, error) {
        // The set that holds the flag
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return (0.0, e)
        }

        // Ask the set, which checks the kind
        return fset.tryGetFloat(name)
    }

    /**
     * tryGetStrs
     * Gives the items of the string slice flag name as resolved along the chain
     * @param name {string} - the long name
     * @return the items, borrowed and never freed by the caller, and a clean error, or an empty list nova owns and the error naming the flag
     **/
    func tryGetStrs(name: string) -> (*Vector<string>, error) {
        // The set that holds the flag, or the leaf's own set when nothing does
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return ((*fset).none, e)
        }

        // Ask the set, which checks the kind
        return fset.tryGetStrs(name)
    }

    /**
     * tryGetCount
     * Gives how many times the count flag name was named, as resolved along the chain
     * @param name {string} - the long name
     * @return the count and a clean error, or 0 and the error naming the flag
     **/
    func tryGetCount(name: string) -> (int64, error) {
        // The set that holds the flag
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return (0, e)
        }

        // Ask the set, which checks the kind
        return fset.tryGetCount(name)
    }

    /**
     * tryChanged
     * Checks if name was set on the command line
     * @param name {string} - the long name
     * @return the answer and a clean error, or false and the error naming the flag
     **/
    func tryChanged(name: string) -> (bool, error) {
        // The set that holds the flag
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return (false, e)
        }

        // Ask the set
        return fset.tryChanged(name)
    }

    /**
     * trySource
     * Gives where the value of name came from, the command line, the environment, a config file or the declaration itself
     * @param name {string} - the long name
     * @return the source and a clean error, or SDefault and the error naming the flag
     **/
    func trySource(name: string) -> (FlagSource, error) {
        // The set that holds the flag
        fset, e := ctxRequireE(self.chain, name)
        if e.exists() {
            return (FlagSource.SDefault, e)
        }

        // Ask the set
        return fset.trySource(name)
    }

    /**
     * arg
     * Gives the positional arg at index i, aborts when out of range
     * @param i {int64} - the index
     * @return the arg
     **/
    func arg(i: int64) -> string {
        // The arg, aborting on a refusal
        v, e := self.tryArg(i)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * getBool
     * Gives the value of the bool flag name as resolved along the chain, aborts when no bool flag of that name is on it
     * @param name {string} - the long name
     * @return the value
     **/
    func getBool(name: string) -> bool {
        // The value, aborting on a refusal
        v, e := self.tryGetBool(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * getStr
     * Gives the value of the string or choice flag name as resolved along the chain, aborts when no such flag is on it
     * @param name {string} - the long name
     * @return the value
     **/
    func getStr(name: string) -> string {
        // The value, aborting on a refusal
        v, e := self.tryGetStr(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * getInt
     * Gives the value of the int flag name as resolved along the chain, aborts when no int flag of that name is on it
     * @param name {string} - the long name
     * @return the value
     **/
    func getInt(name: string) -> int64 {
        // The value, aborting on a refusal
        v, e := self.tryGetInt(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * getFloat
     * Gives the value of the float flag name as resolved along the chain, aborts when no float flag of that name is on it
     * @param name {string} - the long name
     * @return the value
     **/
    func getFloat(name: string) -> float64 {
        // The value, aborting on a refusal
        v, e := self.tryGetFloat(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * getStrs
     * Gives the items of the string slice flag name as resolved along the chain, aborts when no such flag is on it
     * @param name {string} - the long name
     * @return the items, borrowed from the flag and never freed by the caller
     **/
    func getStrs(name: string) -> *Vector<string> {
        // The items, aborting on a refusal
        v0, e := self.tryGetStrs(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        v: *Vector<string> = v0
        return v
    }

    /**
     * getCount
     * Gives how many times the count flag name was named, as resolved along the chain, aborts when no count flag of that name is on it
     * @param name {string} - the long name
     * @return the count
     **/
    func getCount(name: string) -> int64 {
        // The count, aborting on a refusal
        v, e := self.tryGetCount(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * changed
     * Checks if name was set on the command line, aborts when no command on the chain declares it
     * @param name {string} - the long name
     * @return true when set
     **/
    func changed(name: string) -> bool {
        // The answer, aborting on a refusal
        v, e := self.tryChanged(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * source
     * Gives where the value of name came from, the command line, the environment, a config file or the declaration itself, aborts when no command on the chain declares it
     * @param name {string} - the long name
     * @return the source
     **/
    func source(name: string) -> FlagSource {
        // The source, aborting on a refusal
        v, e := self.trySource(name)
        if e.exists() {
            novaFaultMsg(e.message)
        }
        return v
    }

    /**
     * commandPath
     * Gives the full path of the running command, such as "app serve"
     * @return the path
     **/
    func commandPath() -> string {
        // The running command
        c: *Command = self.cmd

        // Return its path
        return (*c).path
    }

    /**
     * print
     * Writes text to the out sink of the chain, nothing is added to it
     * @param s {string} - the text, borrowed
     * @return nothing
     **/
    func print(s: string) -> void {
        // The chain
        chain: *Vector<*Command> = self.chain

        // Write the text as it stands
        sinkWrite(sinkResolveOut(chain), s)
    }

    /**
     * println
     * Writes text to the out sink of the chain with a newline after it
     * @param s {string} - the text, borrowed
     * @return nothing
     **/
    func println(s: string) -> void {
        // The chain
        chain: *Vector<*Command> = self.chain

        // The text with its newline
        line: string = s + "\n"

        // Write the line and free the copy
        sinkWrite(sinkResolveOut(chain), line)
        free(line)
    }

    /**
     * eprint
     * Writes text to the err sink of the chain, nothing is added to it
     * @param s {string} - the text, borrowed
     * @return nothing
     **/
    func eprint(s: string) -> void {
        // The chain
        chain: *Vector<*Command> = self.chain

        // Write the text as it stands
        sinkWrite(sinkResolveErr(chain), s)
    }

    /**
     * eprintln
     * Writes text to the err sink of the chain with a newline after it
     * @param s {string} - the text, borrowed
     * @return nothing
     **/
    func eprintln(s: string) -> void {
        // The chain
        chain: *Vector<*Command> = self.chain

        // The text with its newline
        line: string = s + "\n"

        // Write the line and free the copy
        sinkWrite(sinkResolveErr(chain), line)
        free(line)
    }

    /**
     * tryPrintHelp
     * Prints the running command's help through the nearest help func on the chain, or the default renderer to the out sink, a default rendering over the root's help limit printing nothing and coming back as the error
     * @return a clean error, or the help limit error
     **/
    func tryPrintHelp() -> error {
        // A context of the same shape, since a method cannot hand its own receiver on as a pointer
        tmp: *Context = alloc(Context { cmd: self.cmd, root: self.root, chain: self.chain, args: self.args, argv: self.argv })

        // Print the help through whatever the chain resolves to
        e: error = helpDispatchE(tmp)

        // Free the copy
        free(tmp)
        return e
    }

    /**
     * tryPrintUsage
     * Prints the running command's usage block through the nearest usage func on the chain, or the default renderer to the err sink, a default rendering over the root's help limit printing nothing and coming back as the error
     * @return a clean error, or the help limit error
     **/
    func tryPrintUsage() -> error {
        // A context of the same shape, since a method cannot hand its own receiver on as a pointer
        tmp: *Context = alloc(Context { cmd: self.cmd, root: self.root, chain: self.chain, args: self.args, argv: self.argv })

        // Print the usage through whatever the chain resolves to
        e: error = usageDispatchE(tmp)

        // Free the copy
        free(tmp)
        return e
    }

    /**
     * printHelp
     * Prints the running command's help through the nearest help func on the chain, or the default renderer to the out sink, a help text over the root's limit writes an Error: line to the err sink instead
     * @return nothing
     **/
    func printHelp() -> void {
        // Print it and report a refusal on the err sink
        e: error = self.tryPrintHelp()
        if e.exists() {
            line: string = textCat3("Error: ", e.message, "\n")
            sinkWrite(sinkResolveErr(self.chain), line)
            free(line)
            free(e.message)
        }
    }

    /**
     * printUsage
     * Prints the running command's usage block through the nearest usage func on the chain, or the default renderer to the err sink, a usage text over the root's limit writes an Error: line to the err sink instead
     * @return nothing
     **/
    func printUsage() -> void {
        // Print it and report a refusal on the err sink
        e: error = self.tryPrintUsage()
        if e.exists() {
            line: string = textCat3("Error: ", e.message, "\n")
            sinkWrite(sinkResolveErr(self.chain), line)
            free(line)
            free(e.message)
        }
    }

    /**
     * fail
     * Reports an error the Cobra way, "Error: <msg>" on the err sink and the "Run '<path> --help' for usage." hint unless the command silences usage
     * @param msg {string} - the message, borrowed
     * @return 1, the exit code to hand back
     **/
    func fail(msg: string) -> int32 {
        // The running command and the chain its sinks are resolved along
        c: *Command = self.cmd
        chain: *Vector<*Command> = self.chain

        // Report against it
        return ctxReportError(chain, c, msg)
    }
}

/**
 * ctxReportError
 * Writes "Error: <msg>" to the err sink of the chain unless target.silenceErrors and then the hint "Run '<path> --help' for usage." unless target.silenceUsage
 * @param chain {*Vector<*Command>} - the commands root..leaf the sink is resolved along, borrowed
 * @param target {*Command} - the command the error belongs to
 * @param msg {string} - the message, borrowed
 * @return 1
 **/
export func ctxReportError(chain: *Vector<*Command>, target: *Command, msg: string) -> int32 {
    // The sink the run writes its errors to
    errs: Sink = sinkResolveErr(chain)

    // Write the error line unless silenced
    if !(*target).silenceErrors {
        line: string = textCat3("Error: ", msg, "\n")
        sinkWrite(errs, line)
        free(line)
    }

    // Write the usage hint unless silenced
    if !(*target).silenceUsage {
        hint: string = textCat3("Run '", (*target).path, " --help' for usage.\n")
        sinkWrite(errs, hint)
        free(hint)
    }

    // Return the exit code
    return 1
}
